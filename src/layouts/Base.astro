---
import '../styles/global.css';
import { navGroups, homeIcon } from '../data/nav';
import sun from 'lucide-static/icons/sun.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';
import arrowUp from 'lucide-static/icons/arrow-up.svg?raw';
import refresh from 'lucide-static/icons/refresh-cw.svg?raw';
import { ClientRouter } from 'astro:transitions';

interface Props { title: string; description?: string }
const github = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.76 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>';
const { title, description = 'Clear gearing cheatsheets for AION 2 Global.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isActive = (href: string) => path === `${base}${href}`;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title === 'AION 2 Codex' ? title : `${title} · AION 2 Codex`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
        if (t === 'light') document.querySelector('meta[name="color-scheme"]').content = 'light';
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <aside id="side">
        <a class="brand" href={base}><span class="logo">A2</span> Codex</a>
        <nav aria-label="Main">
          <a class="item" href={base} aria-current={path === base ? 'page' : undefined}>
            <span class="ico" set:html={homeIcon} /> Home
          </a>
          {navGroups.map((g) => (<>
          <h2 class="nav-title">{g.title}</h2>
          {g.items.map((i) =>
            i.ready ? (
              <>
                <a class="item" href={`${base}${i.href}`} aria-current={isActive(i.href) ? 'page' : undefined}>
                  <span class="ico" set:html={i.icon} /> {i.label}
                </a>
                {i.children?.map((c) => <a class="item sub child" href={`${base}${i.href}#${c.hash}`} data-hash={c.hash}>{c.label}</a>)}
              </>
            ) : (
              <span class="item soon" title="Coming soon">
                <span class="ico" set:html={i.icon} /> {i.label}
              </span>
            )
          )}
          </>))}
        </nav>
        <div class="side-tools">
          <button id="theme" type="button" aria-label="Switch theme" title="Switch theme">
            <span class="theme-sun" set:html={sun} /><span class="theme-moon" set:html={moon} />
          </button>
          <a id="repo" href="https://github.com/endyhu/a2-codex" target="_blank" rel="noopener" aria-label="GitHub repository" title="GitHub repository" set:html={github} />
        </div>
      </aside>
      <div class="content">
        <div class="topbar">
          <button id="menu" type="button" aria-label="Open menu" aria-controls="side" aria-expanded="false">Menu</button>
          <a class="brand" href={base}><span class="logo">A2</span> Codex</a>
        </div>
        <main><slot /></main>
        <footer>Global server. Fan-made, not affiliated with NCSOFT. AION 2 is a trademark of its owner.</footer>
      </div>
    </div>
    <div id="update" transition:persist hidden role="status">
      <span class="update-text"><strong>New version available</strong><small>Click the arrows to reload.</small></span>
      <button type="button" id="update-reload" aria-label="Reload to update" title="Reload to update" set:html={refresh} />
    </div>
    <button id="to-top" type="button" aria-label="Back to top" title="Back to top" set:html={arrowUp} />
    <script>
      // Runs once; the router swaps the page body, so buttons are found again on each page and clicks are delegated.
      const root = document.documentElement;
      const setTheme = (t: string) => {
        root.dataset.theme = t;
        document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!.content = t;
      };
      const showTop = () => document.getElementById('to-top')!.classList.toggle('show', scrollY > 700);
      const labelTheme = () => {
        const themeBtn = document.getElementById('theme')!;
        const label = root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
        themeBtn.setAttribute('aria-label', label);
        themeBtn.title = label;
      };
      addEventListener('scroll', showTop, { passive: true });
      // The incoming page's <html> says dark: put the saved theme back before it is shown.
      document.addEventListener('astro:after-swap', () => {
        try { const t = localStorage.getItem('theme'); if (t) setTheme(t); } catch {}
      });
      // Links to a section of the current page are left to the browser so they keep the smooth scroll (the router jumps instantly).
      const markSectionLinks = () =>
        document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((a) => a.toggleAttribute('data-astro-reload', a.pathname === location.pathname));
      // Links to other sites open in a new tab so the app stays open.
      const markExternalLinks = () =>
        document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((a) => {
          if (a.origin === location.origin) return;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        });
      document.addEventListener('astro:page-load', () => { showTop(); labelTheme(); markSectionLinks(); markExternalLinks(); });
      // The browser's section jump leaves a history entry without router state, so Back to it would not swap the page in.
      // Copy the previous entry's state onto it, as the router does for its own section jumps.
      let jumpedFrom: unknown = null;
      document.addEventListener('click', (e) => { if ((e.target as Element).closest('a[data-astro-reload]')) jumpedFrom = history.state; }, { capture: true });
      addEventListener('hashchange', () => { if (!history.state && jumpedFrom) history.replaceState(jumpedFrom, ''); });
      // Open tabs never see a new deploy on their own: compare the baked-in build id with the live one.
      declare const __BUILD_ID__: string;
      const checkVersion = async () => {
        try {
          const res = await fetch(`${import.meta.env.BASE_URL}version.json`, { cache: 'no-store' });
          if (res.ok && (await res.json()).id !== __BUILD_ID__) document.getElementById('update')!.hidden = false;
        } catch {}
      };
      // After updating, other pages may still sit in the HTTP cache as the old build; their old script would raise the bar again.
      // Once an update was seen, refresh each page's cache entry before the router loads it.
      const refreshed = new Set<string>();
      document.addEventListener('astro:before-preparation', (e) => {
        let updating = false;
        try { updating = !!sessionStorage.getItem('updating'); } catch {}
        const url = e.to.href;
        if (!updating || refreshed.has(url)) return;
        const load = e.loader;
        e.loader = async () => {
          try { await fetch(url, { cache: 'reload' }); refreshed.add(url); } catch {}
          await load();
        };
      });
      document.addEventListener('visibilitychange', () => { if (!document.hidden) checkVersion(); });
      setInterval(checkVersion, 5 * 60 * 1000);
      checkVersion();
      document.addEventListener('click', (e) => {
        const t = e.target as Element;
        if (t.closest('#update-reload')) {
          try { sessionStorage.setItem('updating', '1'); } catch {}
          fetch(location.href, { cache: 'reload' }).catch(() => {}).finally(() => location.reload());
        }
        else if (t.closest('#to-top')) scrollTo({ top: 0 });
        else if (t.closest('#theme')) {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          setTheme(next);
          labelTheme();
          try { localStorage.setItem('theme', next); } catch {}
        } else if (t.closest('#menu')) {
          const open = document.body.classList.toggle('menu-open');
          document.getElementById('menu')!.setAttribute('aria-expanded', String(open));
        }
      });
    </script>
  </body>
</html>
