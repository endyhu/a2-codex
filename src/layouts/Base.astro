---
import '../styles/global.css';
import { nav, homeIcon } from '../data/nav';
import sun from 'lucide-static/icons/sun.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';
import arrowUp from 'lucide-static/icons/arrow-up.svg?raw';

interface Props { title: string; description?: string }
const { title, description = 'Clear gearing cheatsheets for AION 2 Global.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isActive = (href: string) => path === `${base}${href}`;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'AION 2 Codex' ? title : `${title} · AION 2 Codex`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="shell">
      <aside id="side">
        <a class="brand" href={base}><span class="logo">A2</span> Codex</a>
        <nav aria-label="Main">
          <a class="item" href={base} aria-current={path === base ? 'page' : undefined}>
            <span class="ico" set:html={homeIcon} /> Home
          </a>
          {nav.map((g) => (
            <div class="group">
              <div class="group-title">{g.title}</div>
              {g.items.map((i) =>
                i.ready ? (
                  <>
                    <a class={`item${i.sub ? ' sub' : ''}`} href={`${base}${i.href}`} aria-current={isActive(i.href) ? 'page' : undefined}>
                      <span class="ico" set:html={i.icon} /> {i.label}
                    </a>
                    {i.children?.map((c) => <a class="item sub child" href={`${base}${i.href}#${c.hash}`} data-hash={c.hash}>{c.label}</a>)}
                  </>
                ) : (
                  <span class={`item soon${i.sub ? ' sub' : ''}`} title="Coming soon">
                    <span class="ico" set:html={i.icon} /> {i.label}
                  </span>
                )
              )}
            </div>
          ))}
        </nav>
        <button id="theme" type="button" aria-label="Switch theme" title="Switch theme">
          <span class="theme-sun" set:html={sun} /><span class="theme-moon" set:html={moon} />
        </button>
      </aside>
      <div class="content">
        <div class="topbar">
          <button id="menu" type="button" aria-label="Open menu" aria-controls="side" aria-expanded="false">Menu</button>
          <a class="brand" href={base}><span class="logo">A2</span> Codex</a>
        </div>
        <main><slot /></main>
        <footer>Global server. Fan-made, not affiliated with NCSOFT. AION 2 is a trademark of its owner.</footer>
      </div>
    </div>
    <button id="to-top" type="button" aria-label="Back to top" title="Back to top" set:html={arrowUp} />
    <script is:inline>
      const root = document.documentElement;
      const toTop = document.getElementById('to-top');
      const showTop = () => toTop.classList.toggle('show', scrollY > 700);
      addEventListener('scroll', showTop, { passive: true });
      showTop();
      toTop.addEventListener('click', () => scrollTo({ top: 0 }));
      const themeBtn = document.getElementById('theme');
      const labelTheme = () => {
        const label = root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
        themeBtn.setAttribute('aria-label', label);
        themeBtn.title = label;
      };
      labelTheme();
      themeBtn.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        labelTheme();
        try { localStorage.setItem('theme', next); } catch {}
      });
      const menu = document.getElementById('menu');
      menu.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        menu.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
