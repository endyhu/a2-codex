---
import '../styles/global.css';
import { nav, homeIcon } from '../data/nav';
import sun from 'lucide-static/icons/sun.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';
import arrowUp from 'lucide-static/icons/arrow-up.svg?raw';
import { ClientRouter } from 'astro:transitions';

interface Props { title: string; description?: string }
const { title, description = 'Clear gearing cheatsheets for AION 2 Global.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isActive = (href: string) => path === `${base}${href}`;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title === 'AION 2 Codex' ? title : `${title} · AION 2 Codex`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
        if (t === 'light') document.querySelector('meta[name="color-scheme"]').content = 'light';
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <aside id="side">
        <a class="brand" href={base}><span class="logo">A2</span> Codex</a>
        <nav aria-label="Main">
          <a class="item" href={base} aria-current={path === base ? 'page' : undefined}>
            <span class="ico" set:html={homeIcon} /> Home
          </a>
          {nav.map((g) => (
            <div class="group">
              <div class="group-title">{g.title}</div>
              {g.items.map((i) =>
                i.ready ? (
                  <>
                    <a class={`item${i.sub ? ' sub' : ''}`} href={`${base}${i.href}`} aria-current={isActive(i.href) ? 'page' : undefined}>
                      <span class="ico" set:html={i.icon} /> {i.label}
                    </a>
                    {i.children?.map((c) => <a class="item sub child" href={`${base}${i.href}#${c.hash}`} data-hash={c.hash}>{c.label}</a>)}
                  </>
                ) : (
                  <span class={`item soon${i.sub ? ' sub' : ''}`} title="Coming soon">
                    <span class="ico" set:html={i.icon} /> {i.label}
                  </span>
                )
              )}
            </div>
          ))}
        </nav>
        <button id="theme" type="button" aria-label="Switch theme" title="Switch theme">
          <span class="theme-sun" set:html={sun} /><span class="theme-moon" set:html={moon} />
        </button>
      </aside>
      <div class="content">
        <div class="topbar">
          <button id="menu" type="button" aria-label="Open menu" aria-controls="side" aria-expanded="false">Menu</button>
          <a class="brand" href={base}><span class="logo">A2</span> Codex</a>
        </div>
        <main><slot /></main>
        <footer>Global server. Fan-made, not affiliated with NCSOFT. AION 2 is a trademark of its owner.</footer>
      </div>
    </div>
    <div id="update" transition:persist hidden>
      New version available
      <button type="button" id="update-reload">Reload</button>
    </div>
    <button id="to-top" type="button" aria-label="Back to top" title="Back to top" set:html={arrowUp} />
    <script>
      // Runs once; the router swaps the page body, so buttons are found again on each page and clicks are delegated.
      const root = document.documentElement;
      const setTheme = (t: string) => {
        root.dataset.theme = t;
        document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!.content = t;
      };
      const showTop = () => document.getElementById('to-top')!.classList.toggle('show', scrollY > 700);
      const labelTheme = () => {
        const themeBtn = document.getElementById('theme')!;
        const label = root.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
        themeBtn.setAttribute('aria-label', label);
        themeBtn.title = label;
      };
      addEventListener('scroll', showTop, { passive: true });
      // The incoming page's <html> says dark: put the saved theme back before it is shown.
      document.addEventListener('astro:after-swap', () => {
        try { const t = localStorage.getItem('theme'); if (t) setTheme(t); } catch {}
      });
      // Links to a section of the current page are left to the browser so they keep the smooth scroll (the router jumps instantly).
      const markSectionLinks = () =>
        document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((a) => a.toggleAttribute('data-astro-reload', a.pathname === location.pathname));
      document.addEventListener('astro:page-load', () => { showTop(); labelTheme(); markSectionLinks(); });
      // The browser's section jump leaves a history entry without router state, so Back to it would not swap the page in.
      // Copy the previous entry's state onto it, as the router does for its own section jumps.
      let jumpedFrom: unknown = null;
      document.addEventListener('click', (e) => { if ((e.target as Element).closest('a[data-astro-reload]')) jumpedFrom = history.state; }, { capture: true });
      addEventListener('hashchange', () => { if (!history.state && jumpedFrom) history.replaceState(jumpedFrom, ''); });
      // Open tabs never see a new deploy on their own: compare the baked-in build id with the live one.
      declare const __BUILD_ID__: string;
      const checkVersion = async () => {
        try {
          const res = await fetch(`${import.meta.env.BASE_URL}version.json`, { cache: 'no-store' });
          if (res.ok && (await res.json()).id !== __BUILD_ID__) document.getElementById('update')!.hidden = false;
        } catch {}
      };
      document.addEventListener('visibilitychange', () => { if (!document.hidden) checkVersion(); });
      setInterval(checkVersion, 5 * 60 * 1000);
      checkVersion();
      document.addEventListener('click', (e) => {
        const t = e.target as Element;
        if (t.closest('#update-reload')) location.reload();
        else if (t.closest('#to-top')) scrollTo({ top: 0 });
        else if (t.closest('#theme')) {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          setTheme(next);
          labelTheme();
          try { localStorage.setItem('theme', next); } catch {}
        } else if (t.closest('#menu')) {
          const open = document.body.classList.toggle('menu-open');
          document.getElementById('menu')!.setAttribute('aria-expanded', String(open));
        }
      });
    </script>
  </body>
</html>
