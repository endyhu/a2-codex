---
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Clear gearing cheatsheets for AION 2 Global.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: base, label: 'Home' },
  { href: `${base}stats/`, label: 'Stats' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'AION 2 Codex' ? title : `${title} · AION 2 Codex`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header>
      <div class="bar-inner">
        <a class="brand" href={base}>AION 2 Codex</a>
        <nav>
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button id="theme" type="button" aria-label="Toggle light or dark theme">Theme</button>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="inner">Global server. Fan-made, not affiliated with NCSOFT. AION 2 is a trademark of its owner.</div>
    </footer>
    <script is:inline>
      document.getElementById('theme').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
