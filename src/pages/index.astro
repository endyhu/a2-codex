---
import Base from '../layouts/Base.astro';
import { navGroups } from '../data/nav';
const base = import.meta.env.BASE_URL;
---
<Base title="AION 2 Codex: Gearing Guides and Tools for Global">
  <h1 class="page-title">AION 2 Codex</h1>
  {navGroups.map((g) => (<>
  <h2 class="group-title">{g.title}</h2>
  <div class="cards">
    {g.items.map((i) => {
      const Tag = i.ready ? 'a' : 'div';
      return (
        <Tag class={`card${i.ready ? '' : ' soon'}`} href={i.ready ? `${base}${i.href}` : undefined}>
          <span class="ico" set:html={i.icon} />
          <strong>{i.label}{i.ready ? '' : ' (soon)'}</strong>
          <span class="t">{i.text}</span>
        </Tag>
      );
    })}
  </div>
  </>))}
</Base>
