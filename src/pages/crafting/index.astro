          if (x.src.combo) line += `<small class="cmb">${pc(x.src.p * 100)} combo · ~${+(1 / x.src.p).toFixed(1)} crafts${first !== null ? ` · ${kin(first * x.n)} first try` : ''}</small>`;
        }
        const row = `<tr class="${x.depth ? 'nest d' + Math.min(x.depth, 4) : ''}${x.kind === 'craft' ? ' crafted' : ''}${inc ? ' inc' : ''}"><th scope="row"${x.depth ? ` style="background:${[`linear-gradient(hsl(var(--c${Math.min(x.depth, 4)}) / 0.75),hsl(var(--c${Math.min(x.depth, 4)}) / 0.75)) calc(var(--pad) + ${x.depth} * var(--step)) 0 / 3px 100% no-repeat border-box`, ...Array.from({ length: x.depth - 1 }, (_, k) => `repeating-linear-gradient(hsl(var(--c${Math.min(k + 1, 4)}) / 0.5) 0 2px,transparent 2px 6px) calc(var(--pad) + ${k + 1} * var(--step) + 1px) 0 / 2px 100% no-repeat border-box`), 'linear-gradient(var(--line),var(--line)) 0 100% / 100% 1px no-repeat border-box'].join(',')}"` : ''}><div class="mat" style="--d:${x.depth}"><span class="nm">${x.parent !== undefined && nodes[i - 1]?.id === x.parent && nodes[i - 1].depth === x.depth - 1 ? `<small class="of">Ingredients for ${esc(name(x.parent))}</small>` : ''}<b>${esc(name_)}</b>${line}</span><small class="need"><span class="stp" role="group" aria-label="Have of ${esc(name_)}"><button type="button" data-k="${x.key}" data-d="-1" aria-label="One less">−</button><input class="have" type="text" data-max="${x.total}" value="${x.got}" data-k="${x.key}" inputmode="numeric" autocomplete="off" aria-label="Have of ${esc(name_)}" /><button type="button" data-k="${x.key}" data-d="1" aria-label="One more">+</button></span> /${nf.format(x.total)}${bound ? ' · not tradable' : ''}</small></div></th>`;
        if (ev) {
          // expected cost of one item = the cost of a craft / chance that it combos
          const part = (col: Col, cls: string) => {
            const u = makeCost(x.id, col);
            if (x.n <= 0) return `<td class="na${cls ? ' ' + cls : ''}">—</td>`;
            if (u === null) { miss[col]++; return `<td class="na${cls ? ' ' + cls : ''}">—</td>`; }
            sum[col] += u * x.n;
            return `<td class="made ev${cls ? ' ' + cls : ''}"><b>${kin(u * x.n)}</b><small>${part_ ? `${x.n}/${qs} of ${x.n < qs ? 'a craft' : 'crafts'} · makes ${qs}` : `expected · ${pc(x.src!.p * 100)} combo chance`}</small></td>`;
          };
          return row + part('me', 'c-me') + part('lo', '') + part('hi', '') + '</tr>';
        }
        if (x.kind === 'craft') {
          const part = (col: Col, cls: string) => { const t = subtotal(x, col); return `<td class="made${cls ? ' ' + cls : ''}">${x.n > 0 && t ? `<b>${kin(t)}</b><small>${x.src?.combo ? 'first try' : 'crafted'} · ${nf.format(x.crafts)} ${x.crafts === 1 ? 'craft' : 'crafts'}</small>` : '—'}</td>`; };
          return row + part('me', 'c-me') + part('lo', '') + part('hi', '') + '</tr>';
        }
        if (x.n > 0 && priceOf(x.id).lo) need.set(x.id, (need.get(x.id) ?? 0) + x.n);
        if (bound) { if (x.n > 0 && !inc) { miss.me++; miss.lo++; miss.hi++; } return row + `<td class="na c-me">—</td><td class="na">—</td><td class="na">—</td></tr>`; }
        return row + cell(me, x.n, 'me', 'c-me', false, inc) + cell(lo, x.n, 'lo', 'lo', true, inc) + cell(hi, x.n, 'hi', 'hi', true, inc) + '</tr>';
      });
      const total = (key: Col, cls = '') => `<td${cls ? ` class="${cls}"` : ''}>${sum[key] ? kin(sum[key]) : '—'}<small>${miss[key] ? `${miss[key]} without a price` : ''}</small></td>`;
      rowsEl.innerHTML = body.join('');
      const assumes = nodes.some((x) => x.kind === 'craft' && x.src?.combo), shares = nodes.some((x) => x.kind === 'craft' && !x.src?.combo && x.n > 0 && x.n % craft.recipes[x.src!.ri].qty !== 0);
      foot.innerHTML = `<tr class="sum big"><th scope="row">Total${assumes || shares ? `<small class="cmb">${assumes ? 'Combo items count at expected cost' : 'Items from a craft that makes several count their share'}; the rows under them are one whole craft</small>` : ''}</th>${total('me', 'c-me')}${total('lo')}${total('hi')}</tr>`;
      table.dataset.me = String(state.server ? 1 : 0);
      resetBtn.hidden = ![...have.values()].some((v) => v > 0);
      $('#title').textContent = name(r.product);
      const crafts = steps.get(ri)!, made = crafts * r.qty;
      $('#lead').textContent = `${r.profession}${r.mastery ? ` · Mastery ${r.mastery}` : ''} · ${nf.format(crafts)} ${crafts === 1 ? 'craft' : 'crafts'}${r.qty > 1 ? ` of ${r.qty}` : ''}`;

      // Success and combo chance at the mastery you entered (the recipe's own when empty).
      const lv = state.mast[r.profession] || r.mastery, rateEl = $('#rate');
      $('#mast-l').textContent = `${r.profession} mastery`;
      const mastIn = $<HTMLInputElement>('#mast');
      mastIn.placeholder = String(r.mastery);
      if (document.activeElement !== mastIn) mastIn.value = state.mast[r.profession] ? String(state.mast[r.profession]) : '';
      const sc = rateAt(r.rate?.[0], r.mastery, lv), cb = rateAt(r.rate?.[1], r.mastery, lv);
      if (!r.rate) rateEl.textContent = '';
      else if (lv < r.mastery) rateEl.innerHTML = `<b class="warn">Needs mastery ${r.mastery} to craft</b>`;
      else if (sc !== null) rateEl.innerHTML = `<b class="ok">${pc(sc)} success</b> at mastery ${lv}${lv > r.mastery ? ` (+${lv - r.mastery})` : ''}${cb !== null && r.combo > 0 ? ` · <span>Combo: ${pc(r.combo)} to activate, then ${pc(cb)} to succeed, about ${pc((sc * r.combo * cb) / 1e4)} of crafts end in the combo result</span>` : ''}`;
      else rateEl.textContent = '';

      // Summary: best single server, what the product sells for, profit.
      const stats: string[] = [];
      const stat = (label: string, value: string, cls = '') => stats.push(`<div class="stat"><span>${label}</span><b${cls ? ` class="${cls}"` : ''}>${value}</b></div>`);
      let best: { s: Server; sum: number; miss: number } | null = null;
      if (need.size) {
        for (const s of pool.values()) {
          let t = 0, m = 0;
          for (const [id, n] of need) {
            const p = market.prices[id] ?? [], shop = craft.vendor[id];
            let price = shop ?? Infinity;
            for (let i = 0; i < p.length; i += 3) if (p[i] === s[0]) price = Math.min(price, (state.basis === 'median' ? typical(id, s[0]) : undefined) ?? p[i + 1]);
            if (price === Infinity) m++; else t += price * n;
          }
          if (!best || m < best.miss || (m === best.miss && t < best.sum)) best = { s, sum: t, miss: m };
        }
      }
      const sell = priceOfName(r.product);
      if (sell.me || sell.hi) {
        const mine = sell.me, eff = saleFor(ri);
        stat('Sells for', eff ? kin(eff.price * made) : kin(sell.hi!.price * made));
        if (mine && state.server && !miss.me) {
          const profit = eff!.price * made - sum.me;
          stat('Profit', `${profit >= 0 ? '+' : '−'}${kin(Math.abs(profit))}`, profit >= 0 ? 'ok' : 'warn');
        }
      }
      // A combo swaps the output for the Splendent version of the item (one grade up), when the client has one.
      const cids = r.combo > 0 ? idsByName.get(splendent(name(r.product))) ?? [] : [];
      const cid = cids.find((x) => priceOf(x).me || priceOf(x).hi), cmb = cid ? priceOf(cid) : null;
      if (cid && cmb && (cmb.me || cmb.hi)) {
        const hit = cmb.me ?? cmb.hi!;
        stat('If it combos', kin(hit.price));
      }
      // last: it matters least
      if (best) stat(`Cheapest server · ${esc(best.s[1])}`, kin(best.sum));
      $('#stats').innerHTML = stats.join('');
    };

    const syncServers = () => {
      const pool = market.servers.filter(pick).sort((a, b) => a[1].localeCompare(b[1]) || a[4].localeCompare(b[4]));
      if (!pool.some((s) => s[0] === state.server)) state.server = 0;
      serverEl.innerHTML = '<option value="0">None</option>' + pool.map((s) => `<option value="${s[0]}">${esc(s[1])}${state.faction === 'all' ? ' · ' + s[4] : ''}</option>`).join('');
      serverEl.value = String(state.server);
    };

    document.querySelectorAll<HTMLElement>('#faction, #launch, #basis').forEach((g) => g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      state[g.id as 'faction' | 'launch' | 'basis'] = b.dataset.v!;
      if (g.id === 'launch') { regionsEl(); checked('region', state.region); }
      checked(g.id, b.dataset.v!); syncServers(); persist(); renderList(); renderResult();
    }, { signal }));
    $('#region').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      state.region = b.dataset.v!; checked('region', state.region); syncServers(); persist(); renderList(); renderResult();
    }, { signal });
    serverEl.addEventListener('change', () => { state.server = Number(serverEl.value); persist(); renderList(); renderResult(); }, { signal });
    $('#prof').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      state.prof = b.dataset.v!; state.sub = 'all'; checked('prof', state.prof); renderSub(); persist(); renderList(); listEl.scrollTop = 0;
    }, { signal });
    $('#sort').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      state.sort = b.dataset.v!; checked('sort', state.sort); persist(); renderList(); listEl.scrollTop = 0;
    }, { signal });
    subEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      state.sub = b.dataset.v!; checked('sub', state.sub); persist(); renderList(); listEl.scrollTop = 0;
    }, { signal });
    document.querySelectorAll<HTMLElement>('.qty .step').forEach((b) => b.addEventListener('click', () => {
      state.qty = Math.min(9999, Math.max(1, state.qty + Number(b.dataset.d))); qtyEl.value = String(state.qty); persist(); renderResult();
    }, { signal }));
    let t = 0;
    q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { state.q = q.value; renderList(); listEl.scrollTop = 0; }, 120); }, { signal });
    const mastEl = $<HTMLInputElement>('#mast');
    mastEl.addEventListener('input', () => {
      const r = craft.recipes[keys.indexOf(state.sel)], n = Math.floor(Number(mastEl.value));
      if (!r) return;
      if (n >= 1) state.mast[r.profession] = Math.min(n, 100); else delete state.mast[r.profession];
      persist(); renderResult();
    }, { signal });
    rowsEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.mode button');
      if (!b || b.disabled) return;
      modes.set(Number(b.dataset.id), b.dataset.m as 'craft' | 'buy');
      renderResult();
    }, { signal });
    const resetBtn = $('#reset-have');
    resetBtn.addEventListener('click', () => { have.clear(); persist(); renderResult(); }, { signal });
    qtyEl.addEventListener('input', () => { const n = Math.floor(Number(qtyEl.value)); if (n >= 1) { state.qty = Math.min(n, 9999); persist(); renderResult(); } }, { signal });
    // The box holds how many you already have (starts at 0); the prices cover the rest.
    const setHave = (key: string, v: number, total: number) => { have.set(key, Math.min(total, Math.max(0, Math.floor(v) || 0))); persist(); };
    // A re-render replaces the box, so refocus it with the caret at the end and without the select-all below.
    let refocusing = false;
    const refocus = (sel: string, id?: string) => {
      const el = rowsEl.querySelector<HTMLElement>(`${sel}[data-k="${id}"]`);
      refocusing = true;
      el?.focus();
      if (el instanceof HTMLInputElement) el.setSelectionRange(el.value.length, el.value.length);
      refocusing = false;
    };
    rowsEl.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (!el.classList.contains('have')) return;
      setHave(el.dataset.k!, Number(el.value.replace(/D/g, '')), Number(el.dataset.max));
      renderResult(); refocus('.have', el.dataset.k);
    }, { signal });
    rowsEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.stp button');
      if (!b) return;
      const inp = b.parentElement!.querySelector<HTMLInputElement>('.have')!;
      setHave(b.dataset.k!, Number(inp.value) + Number(b.dataset.d), Number(inp.dataset.max));
      renderResult(); refocus(`.stp button[data-d="${b.dataset.d}"]`, b.dataset.k);
    }, { signal });
    // Mouse wheel over a number box: up adds one, down takes one.
    rowsEl.addEventListener('wheel', (e) => {
      const el = e.target as HTMLInputElement;
      if (!el.classList?.contains('have') || document.activeElement !== el) return;
      e.preventDefault();
      setHave(el.dataset.k!, Number(el.value) + (e.deltaY < 0 ? 1 : -1), Number(el.dataset.max));
      renderResult(); refocus('.have', el.dataset.k);
    }, { signal, passive: false });
    qtyEl.addEventListener('wheel', (e) => {
      if (document.activeElement !== qtyEl) return;
      e.preventDefault();
      state.qty = Math.min(9999, Math.max(1, state.qty + (e.deltaY < 0 ? 1 : -1))); qtyEl.value = String(state.qty); persist(); renderResult();
    }, { signal, passive: false });
    rowsEl.addEventListener('focusin', (e) => { if (!refocusing && (e.target as HTMLElement).classList.contains('have')) (e.target as HTMLInputElement).select(); }, { signal });
    listEl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-i]');
      if (!b) return;
      state.sel = keys[Number(b.dataset.i)];
      loadHave(); modes.clear();
      listEl.querySelectorAll('[aria-pressed="true"]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true');
      persist(); renderResult();
    }, { signal });

    checked('faction', state.faction); checked('launch', state.launch); checked('prof', state.prof); checked('sort', state.sort); checked('basis', state.basis);
    Promise.all([loadMarket(), loadCraft()]).then(([m, c]) => {
      if (signal.aborted) return;
      market = m; craft = c;
      idsByName = new Map();
      for (const [id, nm] of [...Object.entries(c.items).map(([id, v]) => [Number(id), v[0]] as const), ...m.items.map((i) => [i[0], i[1]] as const)]) {
        const l = idsByName.get(nm) ?? idsByName.set(nm, []).get(nm)!;
        if (!l.includes(id)) l.push(id);
      }
      index();
      if (!keys.includes(state.sel)) state.sel = '';
      loadHave();
      const regions = [...new Map(m.servers.map((s) => [s[2], s[3]])).entries()];
      if (!regions.some(([code]) => code === state.region)) state.region = guessRegion(regions.map(([code]) => code));
      regionsEl = () => $('#region').innerHTML = regions.map(([code, n]) => `<button type="button" class="tog" role="radio" aria-checked="false" data-v="${esc(code)}">${esc(n.replace('North America', 'NA'))}<small>${m.servers.filter((s) => s[2] === code && (state.launch === 'all' || (state.launch === 'ea') === !!s[6])).length} servers</small></button>`).join('');
      if (!m.servers.some((s) => s[6])) { noEA = true; state.launch = 'all'; $('#launch-h').hidden = $('#launch').hidden = true; }
      regionsEl(); checked('region', state.region);
      syncServers(); renderSub(); renderList(); renderResult();
      listEl.querySelector('[aria-pressed="true"]')?.scrollIntoView({ block: 'nearest' });
    }).catch(() => { count.textContent = 'Data could not be loaded'; });
  });
</script>
