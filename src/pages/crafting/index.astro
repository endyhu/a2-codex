---
import Base from '../../layouts/Base.astro';
import { bowIcon, daggerIcon, legsIcon, necklaceIcon } from '../../data/icons';
import layoutGrid from 'lucide-static/icons/layout-grid.svg?raw';import anvil from 'lucide-static/icons/anvil.svg?raw';import shield from 'lucide-static/icons/shield.svg?raw';import gem from 'lucide-static/icons/gem.svg?raw';import flask from 'lucide-static/icons/flask-conical.svg?raw';import pot from 'lucide-static/icons/cooking-pot.svg?raw';import rotateCcw from 'lucide-static/icons/rotate-ccw.svg?raw';import chevron from 'lucide-static/icons/chevron-down.svg?raw';

// Icon per item type (the `type` of a recipe in crafting.json); the page script reads them from #sub-icons.
const lucide = import.meta.glob('/node_modules/lucide-static/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const typeIcons: Record<string, string> = Object.fromEntries(Object.entries({
  all: 'layout-grid', Swords: 'shield', Greatswords: 'sword', Maces: 'hammer', Guards: 'shield-half', Staves: 'wand', Orbs: 'orbit', Spellbooks: 'book-open',
  Earrings: 'gem', Necklaces: 'link', Rings: 'circle-dot', Bracelets: 'circle', Helm: 'crown', Pauldrons: 'shield', Top: 'shirt', Cloak: 'ghost', Gloves: 'hand', Shoes: 'footprints', Components: 'package', Consumables: 'flask-conical', Food: 'utensils',
}).map(([type, icon]) => [type, lucide[`/node_modules/lucide-static/icons/${icon}.svg`]]));
typeIcons.Legs = legsIcon;
typeIcons.Bows = bowIcon;
typeIcons.Daggers = daggerIcon;
typeIcons.Necklaces = necklaceIcon;
// Lucide has no sword and shield: a shield with a sword on it.
typeIcons.Swords = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.500-7.700 8.900a1 1 0 0 1-.6 0C7.500 20.500 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.500-1.200 6.200-2.700a1.200 1.200 0 0 1 1.600 0C14.500 3.800 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 7v8M9.500 12h5"/></svg>';
const professions:[string, string, string][] = [['all', 'All', layoutGrid], ['Blacksmithing', 'Blacksmithing', anvil], ['Armorsmithing', 'Armorsmithing', shield], ['Handicrafting', 'Handicrafting', gem], ['Alchemy', 'Alchemy', flask], ['Cooking', 'Cooking', pot]];
const factions: [string, string][] = [['all', 'Both'], ['Elyos', 'Elyos'], ['Asmodian', 'Asmodian']];
---
<Base title="AION 2 Crafting Cost and Profit"description="Material cost of every AION 2 Global recipe on your server, the cheapest server and the most expensive one.">
  <h1 class="page-title">Crafting</h1>

  <div class="cft">
    <section class="panel" id="filters" aria-label="Prices from">
      <header class="panel-head"><h2>Prices from</h2><button type="button" class="fold" aria-expanded="true" aria-controls="filters"><span class="fold-sum"></span><span class="fold-ico" set:html={chevron} /></button></header>

      <h3 class="mini">Region</h3>
      <div class="togs" id="region" role="radiogroup" aria-label="Region"></div>

      <h3 class="mini">Faction</h3>
      <div class="togs seg" id="faction" role="radiogroup" aria-label="Faction">
        {factions.map(([v, l]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v} style={v === "all" ? "" : `--h:${v === "Elyos" ? 200 : 290}`}>{v !== "all" && <i class="dot" />}{l}</button>)}
      </div>

      <h3 class="mini" id="launch-h">Servers</h3>
      <div class="togs seg" id="launch" role="radiogroup" aria-label="Server launch">{[["launch", "Launch"], ["ea", "Early Access"], ["all", "Both"]].map(([v, l]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v}>{l}</button>)}</div>

      <h3 class="mini">Price</h3>
      <div class="togs seg" id="basis" role="radiogroup" aria-label="Price basis">{[["median", "7-day median"], ["now", "Now"]].map(([v, l]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v}>{l}</button>)}</div>

      <h3 class="mini">Your server</h3>
      <select id="server" class="num" aria-label="Your server"><option value="0">None</option></select>

    </section>

    <div class="col">
      <section class="panel" id="recipes" aria-label="Recipe">
        <header class="panel-head"><h2>Recipe</h2><span class="status" id="count">Loading</span></header>
        <div class="togs pf" id="prof" role="radiogroup" aria-label="Profession">
          {professions.map(([v, l, ic]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v}><span class="ico" set:html={ic} />{l}</button>)}
        </div>
        <div class="togs sub" id="sub" role="radiogroup" aria-label="Item type" hidden></div>
        <script type="application/json" id="sub-icons" set:html={JSON.stringify(typeIcons)} />
        <div class="bar">
          <input id="q" class="num search" type="search" placeholder="Search recipes" autocomplete="off" aria-label="Search recipes" />
          <div class="togs seg" id="sort" role="radiogroup" aria-label="Sort recipes" hidden>{[["level", "Item level"], ["profit", "Profit"], ["margin", "Margin"]].map(([v, l]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v}>{l}</button>)}</div>
        </div>
        <div class="rl" id="list"></div>
      </section>

      <section class="panel" id="result" aria-label="Materials" hidden>
        <header class="panel-head">
          <h2 id="title">Materials</h2>
          <div class="ctl">
            <div class="qty" role="group" aria-label="Your mastery">
              <span id="mast-l">Mastery</span>
              <input id="mast" class="solo" type="number" min="1" max="100" inputmode="numeric" aria-label="Your mastery" />
            </div>
            <div class="qty" role="group" aria-label="Amount">
              <span>Amount</span>
              <button type="button" class="step" data-d="-1" aria-label="One less">−</button>
              <input id="qty" type="number" min="1" max="9999" value="1" inputmode="numeric" aria-label="Amount" />
              <button type="button" class="step" data-d="1" aria-label="One more">+</button>
            </div>
          </div>
        </header>
        <p class="meta lead" id="lead"></p>
        <p class="meta rate" id="rate"></p>
        <div class="stats" id="stats"></div>
        <div class="scroll">
          <table class="saving cf" id="table">
            <thead>
              <tr>
                <th scope="col"><div class="mh"><span>Material</span><span class="mh-r"><button type="button" class="rst" id="reset-have" title="Reset counts" aria-label="Reset counts" hidden set:html={rotateCcw} /></span></div></th>
                <th scope="col" class="c-me">Your server</th>
                <th scope="col">Cheapest</th>
                <th scope="col">Most expensive</th>
              </tr>
            </thead>
            <tbody id="rows"></tbody>
            <tfoot id="foot"></tfoot>
          </table>
        </div>
      </section>
    </div>
  </div>

  <p class="meta sources">Recipes: the Global client's crafting tables, via <a href="https://metabot.gg/en/aion-2/crafting">metabot.gg</a>. Prices: the median over 7 days of the cheapest listed unit price per item and server (or the current cheapest, when set to Now), from the <a href="https://aion2.exchange/">Aion2Market</a> public API (same snapshot as Market). Merchant prices (Kina): the crafting, general and substance morph NPC shops, via <a href="https://metabot.gg/en/aion-2/shops">metabot.gg</a>. Craftable components can be crafted or bought. A combo item you craft counts at its expected cost; failed crafts are not counted. Profit and Margin sort by what the product sells for on your server (capped at the median of the servers that list it) minus the cheaper of buying or crafting each material there.</p>
</Base>

<style is:global>
  main { max-width: 1500px; }
  .cft .col { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .cft .col > .panel + .panel { margin-top: 0; }

  .cft .pf { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .cft .pf .tog { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 7px 8px; }
  .cft .sub .tog { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 6px 8px; }
  .cft .ico { display: inline-flex; flex: none; color: var(--muted); transition: color 0.15s; }
  .cft .ico svg { display: block; width: 15px; height: 15px; }
  .cft .tog:hover .ico, .cft .tog:focus-visible .ico { color: var(--text); }
  .cft .tog[aria-checked='true'] .ico { color: var(--accent); }
  .cft .bar { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
  .cft .bar .search { flex: 1 1 200px; }
  .cft .bar .seg[hidden] { display: none; }
  .cft .bar .seg { display: flex; flex: none; }
  .cft .bar .seg .tog { white-space: nowrap; padding: 6px 12px; }
  .cft .rl small.gain { display: flex; justify-content: space-between; gap: 8px; margin-top: 1px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cft .rl small.gain em { flex: none; color: var(--muted); font-style: normal; font-weight: 400; }
  .cft .rl small.gain.ok { color: var(--ok); }
  .cft .rl small.gain.warn { color: var(--warn); }
  .cft .rl { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 4px 8px; max-height: 300px; overflow-y: auto; overscroll-behavior: contain; padding-right: 4px; }
  .cft .rl button { display: block; min-width: 0; padding: 6px 10px; text-align: left; background: var(--panel); border: 1px solid var(--line); border-radius: 3px; color: var(--text); font: inherit; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .cft .rl button:hover, .cft .rl button:focus-visible { background: var(--panel-2); border-color: color-mix(in srgb, var(--accent) 55%, transparent); outline: none; }
  .cft .rl button[aria-pressed='true'] { border-color: color-mix(in srgb, var(--accent) 70%, transparent); background: radial-gradient(120% 140% at 0% 0%, var(--accent-soft), var(--panel) 70%); }
  .cft .rl b { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.86rem; font-weight: 600; }
  .cft .rl small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 0.74rem; }

  .cft .sub { grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); margin-top: 6px; }
  .cft .sub[hidden] { display: none; }
  .cft .ctl { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px 20px; }
  .cft .qty input.solo { width: 4.2em; border-width: 1px; border-radius: 3px; }
  .cft .rate { margin: 0 0 12px; color: var(--muted); }
  .cft .rate b.ok { color: var(--ok); }
  .cft .rate b.warn { color: var(--warn); }
  .cft .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 8px; margin: 0 0 14px; }
  .cft .stats:empty { display: none; }
  .cft .stat { padding: 9px 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 3px; min-width: 0; }
  .cft .stat span { display: block; color: var(--muted); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .cft .stat b { display: block; margin-top: 2px; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .cft .stat b.ok { color: var(--ok); }
  .cft .stat b.warn { color: var(--warn); }
  .cft .stat small { display: block; margin-top: 1px; color: var(--muted); font-size: 0.76rem; }
  .cft .qty { display: flex; align-items: stretch; color: var(--muted); font-size: 0.74rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .cft .qty span { align-self: center; margin-right: 12px; }
  .cft .qty input { width: 4.2em; padding: 5px 4px; text-align: center; background: var(--bg); border: 1px solid var(--line); border-width: 1px 0; color: var(--text); font: inherit; font-size: 0.9rem; letter-spacing: 0; font-variant-numeric: tabular-nums; appearance: textfield; -moz-appearance: textfield; }
  .cft .qty input::-webkit-outer-spin-button, .cft .qty input::-webkit-inner-spin-button { appearance: none; margin: 0; }
  .cft .qty input:focus-visible { outline: none; box-shadow: inset 0 -2px 0 var(--accent); }
  .cft .rst { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; margin-left: 26px; padding: 0; background: none; border: 0; color: var(--muted); cursor: pointer; transition: color 0.15s; }
  .cf .mh { display: flex; align-items: center; justify-content: space-between; }
  .cf .mh-r { width: 9.5em; }
  .cft .rst[hidden] { display: none; }
  .cft .rst svg { width: 16px; height: 16px; }
  .cft .rst:hover, .cft .rst:focus-visible { color: var(--text); outline: none; }
  .cft .qty .step { padding: 0; background: var(--panel); border: 1px solid var(--line); color: var(--muted); font: inherit; font-size: 1rem; line-height: 1; cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .cft .qty .step:first-of-type { border-radius: 3px 0 0 3px; }
  .cft .qty .step:last-of-type { border-radius: 0 3px 3px 0; }
  .cft .qty .step:hover, .cft .qty .step:focus-visible { border-color: color-mix(in srgb, var(--accent) 55%, transparent); color: var(--text); outline: none; }
  .cft .lead { margin: 0 0 8px; }
  .cft .scroll { overflow-x: auto; }
  .cf { table-layout: fixed; width: 100%; --pad: 10px; --step: 26px; --c1: 255 85% 70%; --c2: 190 70% 52%; --c3: 38 90% 58%; --c4: 330 75% 66%; }
  .cf th:nth-child(n+2) { width: 18%; }
  .cf[data-me='0'] .c-me { display: none; }
  .cf[data-me='0'] th:nth-child(n+2) { width: 22%; }
  .cf td, .cf tbody th { overflow-wrap: anywhere; }
  .cf tbody th { text-transform: none; letter-spacing: normal; font-size: inherit; color: var(--text); text-align: left; }
  .cf td b, .cf th b { display: block; font-weight: 600; }
  .cf small { display: block; color: var(--muted); font-weight: 400; opacity: 1; }
  .cf td.na { color: var(--muted); }
  .cf tfoot td small { font-weight: 400; }
  .cf .mat { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px 12px; margin-left: calc(var(--d, 0) * var(--step)); }
  .cf .nm > b { min-width: 0; }
  @media (min-width: 1700px) { .cf .nm > b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } }
  .cf .need { display: flex; align-items: center; flex-wrap: wrap; flex: none; width: 9.5em; gap: 4px 5px; white-space: nowrap; }
  .cf .stp { display: inline-flex; align-items: stretch; }
  .cf .stp button { width: 20px; padding: 0; background: transparent; border: 1px solid var(--line); color: var(--muted); font: inherit; font-size: 0.95rem; line-height: 1; cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .cf .stp button:first-child { border-radius: 3px 0 0 3px; }
  .cf .stp button:last-child { border-radius: 0 3px 3px 0; }
  .cf .stp button:hover, .cf .stp button:focus-visible { border-color: color-mix(in srgb, var(--accent) 55%, transparent); color: var(--text); outline: none; }
  .cf .have { width: 2.7em; padding: 1px 0; text-align: center; background: var(--bg); border: 1px solid var(--line); border-width: 1px 0; color: var(--text); font: inherit; font-size: 0.82rem; font-weight: 700; font-variant-numeric: tabular-nums; appearance: textfield; -moz-appearance: textfield; }
  .cf .have::-webkit-outer-spin-button, .cf .have::-webkit-inner-spin-button { appearance: none; margin: 0; }
  .cf .have:focus-visible { outline: none; box-shadow: inset 0 -2px 0 var(--accent); }
  .cf td.stale b { opacity: 0.6; }
  .cf td.stale small { font-style: italic; }
  .cf td.lo b { color: var(--ok); }
  .cf td.hi b { color: var(--warn); }
  /* one colour per nesting level: sub, sub-sub, ... */
  .cf tr.d1 { --c: var(--c1); }
  .cf tr.d2 { --c: var(--c2); }
  .cf tr.d3 { --c: var(--c3); }
  .cf tr.d4 { --c: var(--c4); }
  .cf tr.nest th { border-bottom-color: transparent; } /* the row line is drawn inside the cell, full width and under the bars, so the bars run unbroken */
  .cf tr.nest { background: hsl(var(--c) / 0.06); }
  .cf tr.nest .mat { padding-left: 12px; }
  .cf tr.nest .nm small.of { color: hsl(var(--c)); }
  .cf .nm small.of { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0 0 3px; color: var(--muted); font-size: 0.66rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .cf .nm { display: block; flex: 1 1 11em; min-width: 0; }
  .cf .nm small { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; margin-top: 3px; font-size: 0.76rem; }
  .cf .nm small.cmb, .cf tfoot small.cmb { color: color-mix(in srgb, var(--accent) 80%, var(--muted)); }
  .cf .nm small.cmb { font-size: 0.7rem; }
  .cf tfoot small.cmb { margin-top: 2px; font-size: 0.72rem; font-weight: 600; text-transform: none; letter-spacing: 0; }
  .cf tr.crafted td.made b { color: var(--muted); font-weight: 600; }
  .cf tr.crafted td.made.ev b { color: var(--text); }
  .cf tr.inc td:not(:first-child) { opacity: 0.5; }
  .cf td.made small { font-style: italic; }
  .cf .mode { display: inline-flex; flex: none; }
  .cf .mode button { padding: 2px 9px; background: var(--panel); border: 1px solid var(--line); color: var(--muted); font: inherit; font-size: 0.74rem; font-weight: 600; cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .cf .mode button:first-child { border-radius: 3px 0 0 3px; }
  .cf .mode button:last-child { border-radius: 0 3px 3px 0; margin-left: -1px; }
  .cf .mode button:hover:not(:disabled), .cf .mode button:focus-visible { border-color: color-mix(in srgb, var(--accent) 55%, transparent); color: var(--text); outline: none; }
  .cf .mode button[aria-pressed='true'] { position: relative; color: var(--text); border-color: color-mix(in srgb, var(--accent) 70%, transparent); background: radial-gradient(120% 140% at 0% 0%, var(--accent-soft), var(--panel) 70%); }
  .cf .mode button:disabled { opacity: 0.45; cursor: default; }

  @media (max-width: 1100px) { .cft .pf { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* Touch: bigger steppers and Craft / Buy buttons. */
  @media (pointer: coarse) {
    .cf .stp button { width: 30px; }
    .cf .have { padding: 4px 0; }
    .cf .need { width: auto; }
    .cf .mh-r { width: auto; }
    .cft .rst { margin-left: 0; }
    .cf .mode button { padding: 6px 12px; }
    .cft .qty .step { width: 38px; }
  }
  @media (max-width: 600px) {
    .cft .pf { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cft .pf .tog { justify-content: flex-start; }
    .cft .rl { max-height: min(420px, 55vh); }
    .cft .rl b, .cft .rl small { white-space: normal; }
    .cft .ctl { flex: 1 1 100%; justify-content: space-between; }
    .cft .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cft .stat b { font-size: 1.05rem; }
    .cf thead th { text-transform: none; letter-spacing: 0; font-size: 0.72rem; line-height: 1.25; vertical-align: bottom; }
    .cf { display: table; font-size: 0.78rem; --pad: 4px; --step: 9px; }
    .cf th, .cf td { padding: 6px 4px; }
    .cf th:nth-child(n+2) { width: 20%; }
    .cf .mat { gap: 4px 8px; }
    .cf tr.nest .mat { padding-left: 7px; }
    .cf .nm small.of { display: none; }
    .cf td.made small, .cf td.na small { display: none; }
  }
</style>

<script>
  import { guessRegion } from '../../scripts/region';
  import { oneOf, readUrl, writeUrl } from '../../scripts/urlstate';
  import { foldPanel } from '../../scripts/fold';
  type Server = [number, string, string, string, string, string, number];
  type Market = { generated: string; servers: Server[]; items: [number, string, string, string, number][]; prices: Record<string, number[]>; typical?: Record<string, number[]>; sold?: Record<string, number[]>; last?: Record<string, number[]> };
  type Recipe = { product: number; qty: number; mastery: number; profession: string; level?: number; faction?: 'Elyos' | 'Asmodian'; type: string; combo: number; rate?: [string, string]; parts: [number, number][] };
  type Craft = { generated: string; items: Record<string, [string, string]>; vendor: Record<string, number>; curves: Record<string, number[]>; recipes: Recipe[] };
  type Saved = { region: string; faction: string; launch: string; server: number; prof: string; sub: string; sel: string; qty: number; mast: Record<string, number>; sort: string; basis: string; have: Record<string, Record<string, number>> };
  type Hit = { price: number; s: Server; stale?: number; now?: number }; // now: the current cheapest listing, set when the price shown is the 7-day median and differs // stale: hours since the price was last seen listed
  const STORE = 'a2codex-crafting-v1';
  const nf = new Intl.NumberFormat('en-US');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const once = <T,>(url: string) => { let p: Promise<T> | null = null; return () => (p ??= fetch(url, { cache: 'no-cache' }).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json() as Promise<T>; }).catch((e) => { p = null; throw e; })); };
  const loadMarket = once<Market>('/market.json'), loadCraft = once<Craft>('/crafting.json');
  const ageText = (h: number) => (h < 48 ? `${Math.max(1, h)} h ago` : `${Math.round(h / 24)} d ago`);
  const kin = (n: number) => (n >= 1e9 ? `${+(n / 1e9).toFixed(2)}B` : n >= 1e6 ? `${+(n / 1e6).toFixed(2)}M` : nf.format(Math.round(n)));

  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('recipes')) return;
    const ac = new AbortController();
    const { signal } = ac;
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    foldPanel(document.getElementById('filters')!, signal);
    const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const count = $('#count'), listEl = $('#list'), result = $('#result'), rowsEl = $('#rows'), foot = $('#foot'), table = $('#table');
    const subEl = $('#sub');
    const icons: Record<string, string> = JSON.parse($('#sub-icons').textContent || '{}');
    const q = $<HTMLInputElement>('#q'), qtyEl = $<HTMLInputElement>('#qty'), serverEl = $<HTMLSelectElement>('#server');

    let saved: Partial<Saved> = {};
