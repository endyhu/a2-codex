---
import Base from '../layouts/Base.astro';
import TagGroup from '../components/TagGroup.astro';
import fist from 'lucide-static/icons/hand-fist.svg?raw';
import wind from 'lucide-static/icons/wind.svg?raw';
import book from 'lucide-static/icons/book-open-text.svg?raw';
import heart from 'lucide-static/icons/heart.svg?raw';
import eye from 'lucide-static/icons/eye.svg?raw';
import sparkle from 'lucide-static/icons/sparkle.svg?raw';
import sword from 'lucide-static/icons/sword.svg?raw';
import scale from 'lucide-static/icons/scale.svg?raw';
import bird from 'lucide-static/icons/bird.svg?raw';
import tree from 'lucide-static/icons/tree-deciduous.svg?raw';
import skull from 'lucide-static/icons/skull.svg?raw';
import compass from 'lucide-static/icons/compass.svg?raw';
import hourglass from 'lucide-static/icons/hourglass.svg?raw';
import orbit from 'lucide-static/icons/orbit.svg?raw';
import sources from '../data/stat-sources.json';
import { nav } from '../data/nav';
import { deityOrder } from '../data/deity-order';

// Lucide has no butterfly or shield-with-sword; drawn in the same style (24px grid, 2px round strokes).
const shieldSword = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.500 20.500 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.500-1.200 6.240-2.720a1.170 1.170 0 0 1 1.520 0C14.510 3.810 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 7v9"/><path d="M9.500 10h5"/></svg>`;
const butterfly = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v12"/><path d="M12 11C12 6 9 3 5.5 3 3.5 3 3.5 6 4.5 9 5.5 12 8.5 12.5 12 11z"/><path d="M12 11c0-5 3-8 6.5-8 2 0 2 3 1 6-1 3-4 3.5-7.5 2z"/><path d="M12 13c-4 0-7 1-7 4 0 3 3 3.5 5 1.5l2-2.500"/><path d="M12 13c4 0 7 1 7 4 0 3-3 3.500-5 1.500l-2-2.500"/><path d="M10.500 3.500 9 1.500M13.500 3.500 15 1.500"/></svg>`;

// Left: a wheel like the in-game Stat Info window (six primary stats inside ten Daevanion stats), fixed to the screen on
// desktop. Right: the stats that matter most, ranked, with what raises each one and where to get it.
// hue is an HSL hue used to tint each node.
const primary = [
  { name: 'Might', icon: fist, hue: 8, effects: ['Attack'] },
  { name: 'Dexterity', icon: wind, hue: 160, effects: ['Evasion', 'Block', 'Critical Hit Resist'] },
  { name: 'Precision', icon: eye, hue: 40, effects: ['Accuracy', 'Critical Hit'] },
  { name: 'Willpower', icon: sparkle, hue: 210, effects: ['Status Effect Resist'] },
  { name: 'Intelligence', icon: book, hue: 265, effects: ['Status Effect Chance'] },
  { name: 'Constitution', icon: heart, hue: 350, effects: ['HP'] },
];
// Ring order matches the game: left column top to bottom, then right column top to bottom.
const daevanion = [
  { name: 'Justice', deity: 'Nezekan', icon: shieldSword, hue: 215, effects: ['Defense', 'Perfect Chance'] },
  { name: 'Freedom', deity: 'Vaizel', icon: bird, hue: 175, effects: ['Accuracy', 'Evasion'] },
  { name: 'Illusion', deity: 'Kaisinel', icon: butterfly, hue: 300, effects: ['Cooldown reduction', 'Endurance Penetration'] },
  { name: 'Life', deity: 'Yustiel', icon: tree, hue: 130, effects: ['HP', 'Regeneration'] },
  { name: 'Time', deity: 'Siel', icon: hourglass, hue: 195, effects: ['Combat Speed', 'Double Resist'] },
  { name: 'Destruction', deity: 'Zikel', icon: sword, hue: 10, effects: ['Attack', 'Perfect Resist'] },
  { name: 'Death', deity: 'Triniel', icon: skull, hue: 280, effects: ['Critical Hit', 'Regeneration Penetration'] },
  { name: 'Wisdom', deity: 'Lumiel', icon: compass, hue: 48, effects: ['MP Cost reduction', 'Double Chance'] },
  { name: 'Destiny', deity: 'Marchutan', icon: scale, hue: 330, effects: ['MP', 'Endurance'] },
  { name: 'Space', deity: 'Israphel', icon: orbit, hue: 245, effects: ['Move Speed', 'Block'] },
];
const at = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return `left:${(50 + r * Math.cos(a)).toFixed(2)}%;top:${(50 + r * Math.sin(a)).toFixed(2)}%`;
};
// Five per side, 30 degrees apart, mirrored.
const ringAngles = [240, 210, 180, 150, 120, -60, -30, 0, 30, 60];
const nodes = [
  ...primary.map((s, i) => ({
    ...s, kind: 'primary', style: `${at(-90 + 60 * i, 22)};--h:${s.hue}`, title: s.name,
    text: `Each point gives +0.1% ${s.effects.join(', ')}.`,
  })),
  ...daevanion.map((s, i) => ({
    ...s, kind: 'deity', style: `${at(ringAngles[i], 41)};--h:${s.hue}`, title: `${s.name} [${s.deity}]`,
    text: `Daevanion priority ${deityOrder.indexOf(s.name) + 1} of ${deityOrder.length}. Each point gives +0.1% ${s.effects.join(' and ')}.`,
  })),
];
// The stats that matter most for damage, in order. Order and notes follow aion2bible.com (its Stat Value Index and
// "How Stats Work" chapter); descriptions are the in-game text from aion2data.com. [[x]] in text shows red.
// Combat Speed is placed second because the Bible calls it a stat to stack as much as you can; it does not rank it
// against the others. The stats that come from Daevanion stats (Double Chance, Combat Speed, Cooldown, Perfect Chance,
// Critical Hit, Accuracy, Endurance) follow the owner's Daevanion order (src/data/deity-order.ts), except Attack: Destruction
// ranks above Justice because Daevanion stats are percentages, while the Attack stat here is flat and ranks below Perfect Chance.
const ranked = [
  { name: 'Double Chance', from: ['Wisdom'], text: 'Increases Double activation chance. Affected by target\'s Double Resist.', note: 'A Double hit deals 2x damage in PvE, which makes this the strongest damage stat. Every extra point is worth a little less than the last.' },
  { name: 'Combat Speed', from: ['Time'], text: 'Increases Attack Speed and Spell Action Speed.', note: 'Faster casts and attacks mean more hits. Stack as much as you can. High ping or low FPS cuts into what it gives you.' },
  { name: 'Front / Back Attack Damage Boost', text: 'Boosts Damage when successfully attacking from the front. Boosts Damage when successfully attacking from behind. Ignores target\'s Block when attacking from behind.', note: 'Has its own damage bracket, so it is not added to your other Damage Boosts. It starts at 0%, which makes the first points worth a lot.' },
  { name: 'Weapon Damage Boost', text: 'Boosts Weapon Damage. Affected by target\'s Weapon Damage Tolerance.', note: 'Has its own damage bracket and only multiplies the Attack that comes from your gear. The more gear Attack you have, the more it gives.' },
  { name: 'Critical Damage Boost', text: 'Boosts Critical Hit Damage. Affected by target\'s Critical Damage Tolerance.', note: 'Crit damage starts at 50%, and class passives that raise it lower what this stat is worth. It is worth more if your class has none.' },
  { name: 'Damage Boost', text: 'Boosts Damage. Affected by target\'s Damage Tolerance.', note: 'Adds together with PvE, Boss and Species Damage Boost, so each point gives less than the stats above.' },
  { name: 'Multi-hit Chance', text: 'Increases Multi-hit Chance. Adds up to 4 hits, inflicting damage proportional to Attack.', note: 'Each extra hit does only a small share of the original hit. How exactly it stacks with your other damage is still being tested.' },
  { name: 'Cooldown', from: ['Illusion'], text: 'Skill Cooldown duration. Negative value reduces Cooldown. Cooldown reduction is capped at [[60%]].', note: 'Most classes only need around 30-40% to keep their key buffs rolling. Find your class\'s number and stop there instead of stacking it.' },
  { name: 'Perfect Chance', from: ['Justice'], text: 'Increases Perfect activation chance. Affected by target\'s Perfect Resist.', note: 'A Perfect hit rolls the top of your weapon\'s damage range. That range is usually narrow, so it adds less than it sounds.' },
  { name: 'Attack', from: ['Might', 'Destruction'], text: 'Basic Attack. Higher Attack deals more damage.', note: 'The best of the flat Attack stats, because Weapon Damage Boost multiplies it directly. The Attack number on your Stat Info does not include that bonus.' },
  { name: 'Max Attack', text: 'Max Attack of the weapon. Perfect scales with Max Attack.', note: 'Raises the top of your weapon\'s damage range and its average. The second best flat Attack stat.' },
  { name: 'Attack Bonus', text: 'Basic Attack. Affects Damage.', note: 'Added after Weapon Damage Boost is applied. Weaker per point than Attack and Max Attack, but still a top stat.' },
  { name: 'Critical Hit', from: ['Precision', 'Death'], text: 'Increases Critical Hit Rate. Max Critical Hit Rate is [[50%]], and this is reduced by target\'s Critical Hit Resist.', note: 'Skill passives add to it, so check how much crit your class already gets before stacking more.' },
  { name: 'Accuracy', from: ['Precision', 'Freedom'], text: 'Prevents attack from missing. Offset by target\'s Evasion and Block.', note: 'Each point cancels a point of the target\'s Block, so once you cover their Block every hit lands. Value drops off as you stack more.' },
  { name: 'Endurance', from: ['Destiny'], text: 'Increases Endurance activation chance. Affected by target\'s Endurance Penetration.', note: 'When it triggers you take half damage. Bosses have no Endurance Penetration, so the % on your sheet is your real chance.' },
];

// "Get it from" tags. Solid tags come from the Global client data (src/data/stat-sources.json, rebuilt with
// scripts/global-sources.mjs). Dashed tags come from community guides or are not confirmed live on Global.
const DEITY = ['Wisdom', 'Time', 'Justice', 'Illusion', 'Destiny', 'Destruction', 'Death', 'Freedom'];
// Genus Insight is not in any client-data site. Global guides (gameplay.tips 2 Oct 2026, odealo 14 Oct 2026) list
// these as the rolls worth chasing.
const GENUS = ['Double Chance', 'Front / Back Attack Damage Boost', 'Weapon Damage Boost', 'Critical Damage Boost', 'Damage Boost',
  'Multi-hit Chance', 'Perfect Chance', 'Max Attack', 'Attack Bonus', 'Critical Hit', 'Accuracy', 'Endurance'];
// A tag links to its page once that page is published (`ready` in nav.ts); until then it stays plain text.
const GEAR_TAGS = ['Helm', 'Pauldrons', 'Top', 'Cloak', 'Gloves', 'Legs', 'Shoes', 'Weapons', 'Earrings', 'Necklace', 'Ring', 'Bracelet',
  'Amulet', 'Belt', 'Rune', 'All armor', 'Manastone'];
const TAG_PAGE: Record<string, string> = {
  Arcana: 'Arcana', Daevanion: 'Daevanion', 'Genus Insight': 'Genus Insight',
  ...Object.fromEntries(GEAR_TAGS.map((g) => [g, 'Gear'])),
};
const pages = nav;
const hrefFor = (label: string) => {
  const page = pages.find((p) => p.label === TAG_PAGE[label] && p.ready);
  return page ? `${import.meta.env.BASE_URL}${page.href}` : undefined;
};
type Tag = { label: string; community?: boolean; href?: string };
// Two groups so the column reads at a glance: what to wear, and every other system.
const tagsFor = (s: { name: string; from?: string[] }) => {
  const d = (sources.stats as Record<string, any>)[s.name];
  const gear: Tag[] = (d?.gear ?? []).map((label: string) => ({ label }));
  if (d?.manastone) gear.push({ label: 'Manastone' });
  const other: Tag[] = [];
  if (d?.daevanion) other.push({ label: 'Daevanion' });
  // Deity stats come from the Abyssal Bracelet (gear), Arcana and Monolith rewards (stats page, "Where deity stats come from").
  if (s.from?.some((f) => DEITY.includes(f))) {
    if (!gear.some((t) => t.label === 'Bracelet')) gear.push({ label: 'Bracelet' });
    other.push({ label: 'Arcana' }); // Monolith rewards also grant them, but they are not something you can plan around
  }
  if (d?.titles) other.push({ label: 'Titles' });
  if (GENUS.includes(s.name)) other.push({ label: 'Genus Insight', community: true });
  if (d?.wings) other.push({ label: 'Wings', community: true });
  const seen = new Set(gear.map((t) => t.label));
  const withHref = (t: Tag): Tag => ({ ...t, href: hrefFor(t.label) });
  return {
    gear: gear.map(withHref),
    other: other.filter((t) => !seen.has(t.label)).map(withHref), // e.g. the Bracelet is already listed under gear when it rolls the stat
  };
};
const rows = ranked.map((s) => ({ ...s, gets: tagsFor(s) }));
---
<Base title="Stats" description="The most important damage stats in AION 2 Global, ranked, with what raises each one and the Daevanion stat wheel.">
  <h1 class="page-title">Stats</h1>

  <div class="split">
    <div class="wheel-slot">
    <section class="wheel-col" aria-label="Stat Info">
    <div class="wheel" role="group" aria-label="Primary and Daevanion stats">
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="41" class="ring" />
        <circle cx="50" cy="50" r="31" class="ring faint" />
        <circle cx="50" cy="50" r="22" class="ring faint" />
        {[0, 1, 2, 3, 4, 5].map((i) => {
          const a = ((-90 + 60 * i) * Math.PI) / 180;
          return <line x1="50" y1="50" x2={50 + 41 * Math.cos(a)} y2={50 + 41 * Math.sin(a)} class="spoke" />;
        })}
      </svg>
      <span class="core" aria-hidden="true"></span>
      {nodes.map((n, i) => (
        <button type="button" class={`tip-src node ${n.kind}`} style={`${n.style};--i:${i}`} data-title={n.title} data-text={n.text} data-name={n.name} data-hue={n.hue} aria-label={`${n.title}. ${n.text}`}>
          <span class="dia"><span class="glyph" set:html={n.icon} /></span>
          <span class="nm">{n.name}</span>
        </button>
      ))}
    </div>
    <ol class="order" aria-label="Daevanion stat priority">
      {deityOrder.map((name, i) => {
        const n = nodes.find((x) => x.name === name)!;
        return <li class="tip-src" tabindex="0" style={`--h:${n.hue}`} data-title={n.title} data-text={n.text} data-name={name} data-hue={n.hue}><b>{i + 1}</b>{name}</li>;
      })}
    </ol>
    </section>
    </div>

    <section class="panel list-col" aria-label="Most important stats">
    <header class="panel-head"><h2>Most important stats</h2></header>
    <div class="cols" aria-hidden="true">
      <span></span><span>Stat</span>
      <div class="what"><span>What it does</span><span>Notes</span><span>Get it from</span></div>
    </div>
    <div class="sub-grid" role="list">
      {rows.map((s, i) => (
        <div class="stat-row" role="listitem" tabindex="0" data-from={s.from?.join(',')}>
          <span class="rank">{i + 1}</span>
          <div class="who">
            <strong>{s.name}</strong>
            {s.from && (
              <span class="from">
                {s.from.map((f) => {
                  const src = nodes.find((n) => n.name === f)!;
                  return (
                    <span class="src" style={`--h:${src.hue}`}>
                      <span class="glyph" set:html={src.icon} />
                      {src.name}
                    </span>
                  );
                })}
              </span>
            )}
          </div>
          <div class="what">
            <p set:html={s.text.replace(/\[\[(.+?)\]\]/g, '<span class="hot">$1</span>')} />
            <p class="note">{s.note}</p>
            {(s.gets.gear.length > 0 || s.gets.other.length > 0) && (
              <div class="gets">
                {s.gets.gear.length > 0 && <TagGroup label="Gear" tags={s.gets.gear} />}
                {s.gets.other.length > 0 && <TagGroup label="Other" tags={s.gets.other} />}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    </section>
  </div>

  <p class="meta sources">Descriptions: <a href="https://aion2data.com/stats">aion2data.com</a>, <a href="https://metabot.gg/en/aion-2/stats">metabot.gg</a> (both read the Global client data). Order and notes: <a href="https://www.aion2bible.com">Aion 2 Bible</a>, a community guide; stats that come from Daevanion stats follow our Daevanion order. Get it from: Global client data, rebuilt from metabot.gg; dashed tags come from community guides.</p>

  <div id="tip" role="tooltip" hidden></div>
</Base>

<script>
  // The router swaps pages in place: set up on every visit, drop window and document listeners on leaving.
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.wheel')) return;
    const ac = new AbortController();
    const { signal } = ac;
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    const tip = document.getElementById('tip')!;
    const wheel = document.querySelector('.wheel')!;
    // The tooltip opens above the anchor point, toward the outside: up-left on the left half of the wheel,
    // up-right on the right half. It flips below the point when there is no room above.
    const place = (x: number, y: number) => {
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      const wr = wheel.getBoundingClientRect();
      const left = x < wr.left + wr.width / 2 - 8 ? x - 14 - w : x + 14;
      tip.style.left = `${Math.max(8, Math.min(left, innerWidth - w - 8))}px`;
      tip.style.top = `${y - 12 - h < 8 ? y + 24 : y - 12 - h}px`;
    };
    // Mouse: the tooltip trails the pointer. Keyboard and touch: anchored to the element's top centre.
    const show = (el: HTMLElement, e?: MouseEvent) => {
      tip.innerHTML = `<strong>${el.dataset.title}</strong><span>${el.dataset.text}</span>`;
      tip.hidden = false;
      if (e) return place(e.clientX, e.clientY);
      const r = el.getBoundingClientRect();
      place(r.left + r.width / 2, r.top);
    };
    const hide = () => (tip.hidden = true);
    // Wheel stats and ranked rows light each other up: a row lists the wheel stats that raise it.
    const nodeEls = [...document.querySelectorAll<HTMLElement>('.node')];
    const rowEls = [...document.querySelectorAll<HTMLElement>('.stat-row')];
    const fromOf = (row: HTMLElement) => (row.dataset.from ?? '').split(',').filter(Boolean);
    const orderEls = [...document.querySelectorAll<HTMLElement>('.order li')];
    const clearLinks = () => [...nodeEls, ...rowEls, ...orderEls].forEach((x) => x.classList.remove('hl'));
    // A row glows in the colour of the wheel stat that raises it; a hovered row uses its first source's colour.
    const hueOf = (name: string) => nodeEls.find((n) => n.dataset.name === name)?.dataset.hue;
    const setHues = (r: HTMLElement, a: string, b = a) => {
      r.style.setProperty('--hl', a);
      r.style.setProperty('--hl2', b);
    };
    const linkNode = (n: HTMLElement) => {
      // The wheel node and its entry in the priority strip light together, whichever one you touch.
      [...nodeEls, ...orderEls].forEach((x) => x.classList.toggle('hl', x.dataset.name === n.dataset.name));
      rowEls.forEach((r) => {
        const on = fromOf(r).includes(n.dataset.name!);
        r.classList.toggle('hl', on);
        if (on) setHues(r, n.dataset.hue!);
      });
    };
    // A row with two sources glows as a gradient between their colours.
    const linkRow = (r: HTMLElement) => {
      const names = fromOf(r);
      const hues = names.map(hueOf).filter((h): h is string => !!h);
      r.classList.add('hl');
      setHues(r, hues[0] ?? '250', hues[1] ?? hues[0] ?? '250');
      [...nodeEls, ...orderEls].forEach((n) => n.classList.toggle('hl', names.includes(n.dataset.name!)));
    };
    const hideAll = () => { hide(); clearLinks(); };
    document.querySelectorAll<HTMLElement>('.tip-src').forEach((el) => {
      el.addEventListener('mouseenter', (e) => { show(el, e); linkNode(el); });
      el.addEventListener('mousemove', (e) => place(e.clientX, e.clientY));
      el.addEventListener('focus', () => { show(el); linkNode(el); });
      el.addEventListener('click', (e) => { e.stopPropagation(); if (tip.hidden) show(el); linkNode(el); });
      el.addEventListener('mouseleave', hideAll);
      el.addEventListener('blur', hideAll);
    });
    rowEls.forEach((r) => {
      r.addEventListener('mouseenter', () => linkRow(r));
      r.addEventListener('focus', () => linkRow(r));
      r.addEventListener('click', (e) => { e.stopPropagation(); linkRow(r); });
      r.addEventListener('mouseleave', clearLinks);
      r.addEventListener('blur', clearLinks);
    });
    document.addEventListener('click', hideAll, { signal });

    // "+N" popup: hover and focus are handled in CSS; a tap toggles it for touch screens, and a tap elsewhere closes it.
    const wraps = document.querySelectorAll<HTMLElement>('.more-wrap');
    const closeWrap = (w: HTMLElement) => {
      w.classList.remove('open');
      const b = w.querySelector<HTMLButtonElement>('.more')!;
      b.setAttribute('aria-expanded', 'false');
      b.blur();
    };
    const closeWraps = () => wraps.forEach(closeWrap);
    wraps.forEach((w) => {
      const b = w.querySelector<HTMLButtonElement>('.more')!;
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !w.classList.contains('open');
        closeWraps();
        w.classList.toggle('open', open);
        b.setAttribute('aria-expanded', String(open));
        if (!open) b.blur(); // tapping again closes at once
      });
      // No pointerleave handling: hover alone closes itself in CSS when the mouse leaves, while a click pins the popup
      // open until the next press outside it (or a second click on the chip).
    });
    // pointerdown, not click: rows and wheel stats stop click propagation, and iOS skips clicks on non-interactive areas.
    document.addEventListener('pointerdown', (e) => {
      if (!(e.target as Element).closest('.more-wrap')) closeWraps();
    }, { signal });
  });
</script>

<style is:global>
  .panel:not(.list-col) .panel-head { text-align: center; }
  .panel:not(.list-col) .panel-head h2 { justify-content: center; }

  .wheel { position: relative; width: 100%; max-width: 540px; aspect-ratio: 1; margin: 0 auto; container-type: inline-size; }
  /* No card: a soft glow behind the wheel lets it sit on the page background. */
  .wheel::before { content: ''; position: absolute; inset: -4%; border-radius: 50%; background: radial-gradient(circle, hsl(250 60% 45% / 0.22) 0%, hsl(250 60% 40% / 0.1) 45%, transparent 70%); pointer-events: none; }
  .wheel > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ring { fill: none; stroke: var(--muted); stroke-opacity: 0.35; stroke-width: 0.35; }
  .ring.faint { stroke-dasharray: 0.8 1.4; stroke-opacity: 0.3; }
  .spoke { stroke: var(--muted); stroke-opacity: 0.25; stroke-width: 0.25; }
  .core { position: absolute; left: 50%; top: 50%; width: 3cqw; height: 3cqw; transform: translate(-50%, -50%) rotate(45deg); background: var(--accent); box-shadow: 0 0 24px 6px var(--accent-soft); }

  .node {
    --c: hsl(var(--h) 75% 64%);
    position: absolute; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: none; border: 0; padding: 0; font: inherit; color: var(--c); cursor: pointer;
  }
  :root[data-theme='light'] .node { --c: hsl(var(--h) 85% 34%); }
  .node .dia { display: grid; place-items: center; width: 100%; height: 100%; background: hsl(var(--h) 60% 50% / 0.14); border: 1.5px solid hsl(var(--h) 70% 55% / 0.45); transition: box-shadow 0.15s, background 0.15s, border-color 0.15s; }
  .node:hover .dia, .node:focus-visible .dia { background: hsl(var(--h) 70% 55% / 0.3); border-color: var(--c); box-shadow: 0 0 18px hsl(var(--h) 80% 55% / 0.5); }
  .node:focus-visible { outline: none; }
  /* One soft glow per node on load, staggered, to show they are interactive. */
  .node .dia { animation: node-hint 1.4s ease-out backwards; animation-delay: calc(0.5s + var(--i) * 70ms); }
  @keyframes node-hint { 0%, 100% { box-shadow: 0 0 0 0 transparent; } 35% { box-shadow: 0 0 18px hsl(var(--h) 80% 55% / 0.6); } }
  @media (prefers-reduced-motion: reduce) { .node .dia { animation: none; } }
  .node.primary { width: 11.5cqw; height: 11.5cqw; }
  .node.primary .dia { border-radius: 28%; background: linear-gradient(150deg, hsl(var(--h) 70% 55% / 0.34), hsl(var(--h) 60% 40% / 0.1)); }
