---
import Base from '../../layouts/Base.astro';
import swords from 'lucide-static/icons/swords.svg?raw';
import crown from 'lucide-static/icons/crown.svg?raw';
import shield from 'lucide-static/icons/shield.svg?raw';
import shirt from 'lucide-static/icons/shirt.svg?raw';
import flag from 'lucide-static/icons/flag-triangle-right.svg?raw';
import hand from 'lucide-static/icons/hand.svg?raw';
import footprints from 'lucide-static/icons/footprints.svg?raw';
import gem from 'lucide-static/icons/gem.svg?raw';
import ear from 'lucide-static/icons/ear.svg?raw';
import ring from 'lucide-static/icons/circle-dot.svg?raw';
import play from 'lucide-static/icons/circle-play.svg?raw';
import unlink from 'lucide-static/icons/unlink.svg?raw';

// Lines are in priority order. Every line below was checked against the random-stat pool of that slot's top Global gear
// (metabot.gg, Global client data; see docs/data-sources.md). Order is from the Aion 2 Bible. Its "Smite" is Double Chance,
// "Movement Speed" is Move Speed. Its Cloak "Perfect Chance" and its Brooch/Pendant are not on Global, so they are left out.
// Each line is [name, roll chance in %], the chance read from the item's random-stat table in the Global client data
// (identical across the top two tiers and across weapon types; the Guard matches too).
type Row = { slot: string; icon: string; lines: [string, number][]; skills?: string };
const lines: Row[] = [
  { slot: 'Weapon / Guard', icon: swords, lines: [['Damage Boost', 2], ['Combat Speed', 4], ['Weapon Damage Boost', 4], ['Might', 6], ['Multi-hit Chance', 6], ['Precision', 7], ['Attack', 7]] },
  { slot: 'Helm', icon: crown, lines: [['Double Chance', 1.2], ['Attack Increase', 1.2], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Pauldrons', icon: shield, lines: [['Double Chance', 1.2], ['Critical Damage Boost', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Top', icon: shirt, lines: [['Perfect Chance', 1.2], ['Damage Boost', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Cloak', icon: flag, lines: [['Double Chance', 1.2], ['Attack Increase', 1.2], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Gloves', icon: hand, lines: [['Perfect Chance', 1.2], ['Combat Speed', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Legs', icon: footprints, lines: [['Attack Increase', 1.2], ['Perfect Chance', 1.2], ['Damage Tolerance', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Shoes', icon: footprints, lines: [['Perfect Chance', 1.2], ['Move Speed', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Earrings', icon: ear, lines: [['Attack', 6], ['Accuracy', 6]], skills: 'Passive skills' },
  { slot: 'Necklace', icon: gem, lines: [['Attack', 6], ['Accuracy', 6]], skills: 'Passive skills' },
  { slot: 'Ring', icon: ring, lines: [['Might', 2], ['Precision', 2], ['Attack', 6]], skills: 'Active skills' },
];
// Tint per stat family: damage multipliers red, Attack amber, speed cyan, attributes violet, survivability green.
const hueOf = (n: string) =>
  /Speed/.test(n) ? 195 : /^(Might|Precision|Accuracy)$/.test(n) ? 280 : /Tolerance/.test(n) ? 150 : n === 'Attack' ? 38 : 8;
// Roll chance per roll on a Superior Manastone, from the Global client data (metabot.gg Manastone guide). Attack is 10% on every regular stone.
const manastones: [string, number][] = [['Front / Back Attack Damage Boost', 0.5], ['Weapon Damage Boost', 0.5], ['Critical Damage Boost', 0.5], ['Damage Boost', 0.5], ['Attack', 10]];
const lostTip = 'Lost on transfer';
// Global client data (metabot.gg gear enhancement guide and calculator): Unique gear is guaranteed to +10, then 65/50/35/25/20% with +5% pity per failure.
// Amplified Enhancement goes past +15, up to +5 depending on item level. Soul Binding has 10 steps. Potential is PvP only.
const order: { t: string; d: string; link?: { label: string; href: string }; lost?: boolean; vis?: 'enhance' | 'amp' }[] = [
  { t: 'Enhance', vis: 'enhance', d: 'Raises the piece from +1 to +15 and its base stats with it. Each try costs Kinah and Enhance Stones. Up to +10 is guaranteed, then a try can fail: 65%, 50%, 35%, 25%, 20% for +11 to +15. A failure costs the materials but never loses a level, and your next try gets +5%. Do your weapon before armor, since it carries the Attack gain.' },
  { t: 'Amplify', vis: 'amp', d: 'Only after +15. Amplify pushes a Unique piece further, and the game shows it as a diamond instead of +x. Each try costs Kinah and Amplify Stones, and the price climbs: 600,000 Kinah and 6 stones for the first diamond, 3,000,000 and 20 for the fifth. All five average about 26 million Kinah and 196 stones. How many diamonds a piece can get depends on its item level: none below 54, 1 at 54, 3 at 70 and 78, 5 at 86 and up (Splendent gear: 70 gets 1, 86 gets 3).' },
  { t: 'Soul Binding', d: 'Raises the piece\'s binding rate over 10 steps (2,130,000 Kinah and 408 Soul Codex in total). At 100% it unlocks an extra Manastone slot, which is the reason to do it. Only worth the cost on gear you will keep.' },
  { t: 'Manastones', d: 'Random stat lines engraved into slots. Do this after enhancing. Use Lesser stones on gear you are only wearing to raise item level, and save Superior stones for gear you keep, because Manastones do not transfer. Chances are below.', lost: true },
  { t: 'Theostone', d: 'A weapon and Guard engraving that can proc when you attack. In PvE it adds only about 1% damage, so do not chase it. In PvP a control stone is worth having, because a Stun in a fight matters more than damage: Meslamtaeda\'s Greed has a 3% chance to Stun for 3s. Otherwise pick whichever looks nicest.', link: { label: 'Theostone previews', href: 'https://www.youtube.com/shorts/MyBzybv75u8' }, lost: true },
  { t: 'Potential', d: 'Adds PvP stats only: +2% PvP Damage Boost on weapon and accessories, PvP Damage Tolerance on armor, at +4. Every step succeeds, but it costs 10 Potential Stones and 400,000 Abyss Points. Skip it if you only do PvE, and only level it on a piece you keep, because it does not transfer.', lost: true },
];
---
<Base title="Gear" description="Best stat lines per slot, Manastones, enhancement order, for AION 2 Global.">
  <h1 class="page-title">Gear</h1>

  <section class="panel" aria-label="Best stat lines per slot">
    <header class="panel-head"><h2>Best stat lines</h2></header>
    <div class="cards">
      {lines.map((r) => (
        <article class="slot-card">
          <header><span class="ico" set:html={r.icon} /><strong>{r.slot}</strong></header>
          <ol>
            {r.lines.map(([l, p], i) => <li class={i === 0 ? 'top' : ''} style={`--h:${hueOf(l)}`}><b>{i + 1}</b>{l}<em>{p}%</em></li>)}
            {r.skills && <li class="rest">{r.skills} for the rest</li>}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="panel" aria-label="Enhancement order">
    <header class="panel-head head-row"><h2>Enhancement order</h2><span class="legend"><span class="lost-ico" set:html={unlink} />Lost on transfer</span></header>
    <ol class="path">
      {order.map((o, i) => (
        <li>
          <b>{i + 1}</b>
          <div>
            <strong>{o.t}{o.lost && <span class="lost-ico" tabindex="0" role="img" aria-label={lostTip} data-tip={lostTip} set:html={unlink} />}</strong>
            <p>{o.d}</p>
            {o.vis === 'enhance' && <span class="levels" aria-hidden="true"><span class="lv">+10</span><span class="lv">+11</span><span class="lv">+12</span><span class="lv">+13</span><span class="lv">+14</span><span class="lv top">+15</span></span>}
            {o.vis === 'amp' && <span class="levels" aria-hidden="true"><span class="lv top">+15</span><span class="arrow">→</span>{[1, 2, 3, 4, 5].map(() => <svg class="gem" viewBox="0 0 24 24"><path d="M12 1.5Q16.5 7.5 22.5 12Q16.5 16.5 12 22.5Q7.5 16.5 1.5 12Q7.5 7.5 12 1.5Z" /><path d="M12 5.2Q14.8 9.2 18.8 12Q14.8 14.8 12 18.8Q9.2 14.8 5.2 12Q9.2 9.2 12 5.2Z" /><path d="M12 8.8Q13.2 10.8 15.2 12Q13.2 13.2 12 15.2Q10.8 13.2 8.8 12Q10.8 10.8 12 8.8Z" /></svg>)}</span>}
            {o.link && <a class="ext" href={o.link.href} target="_blank" rel="noopener"><span set:html={play} />{o.link.label}</a>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <div class="grid">
    <section class="panel" aria-label="Manastones">
      <header class="panel-head"><h2>Manastones</h2></header>
      <ol class="stones">
        {manastones.map(([m, p], i) => <li class={i === 0 ? "first" : ""}><b>{i + 1}</b><span>{m}</span><em>{p}%</em></li>)}
      </ol>
      <small class="sub">Chance per roll on a Superior Manastone. The four Damage Boost lines only roll on Superior stones; a top-tier (Unique) value is 15% of those hits. Weapon Damage Boost and Critical Damage Boost are close. Two yellow Attack lines roughly equal one yellow Damage Boost line; one yellow Attack is a fine placeholder.</small>
    </section>
  </div>

  <p class="meta sources">Lines and roll chances from Global client data (<a href="https://metabot.gg/en/aion-2/items">metabot.gg</a>). Enhancement, Soul Binding, Potential and Manastone chances: Global client data (<a href="https://metabot.gg/en/aion-2/guides/gear-enhancement-guide">metabot.gg</a>). Line and Manastone order: <a href="https://www.aion2bible.com">Aion 2 Bible</a>, a community guide.</p>
</Base>

<style is:global>
  main { max-width: 1500px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 560px), 1fr)); gap: 20px; margin-top: 20px; align-items: start; }

  .stones, .path { list-style: none; margin: 0; padding: 0; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 12px; }
  .slot-card { background: var(--panel); border: 1px solid var(--line); border-radius: 3px; padding: 10px 12px 12px; }
  .slot-card header { display: flex; align-items: center; gap: 10px; padding-bottom: 9px; margin-bottom: 6px; border-bottom: 1px solid var(--line); }
  .slot-card .ico { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; color: var(--accent); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
  .slot-card .ico svg { width: 17px; height: 17px; }
  .slot-card ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; }
  .slot-card li { --c: hsl(var(--h) 75% 64%); display: flex; align-items: baseline; gap: 8px; padding: 4px 8px; border-left: 3px solid hsl(var(--h) 70% 55% / 0.55); background: linear-gradient(90deg, hsl(var(--h) 60% 50% / 0.1), transparent 70%); font-size: 0.86rem; }
  :root[data-theme='light'] .slot-card li { --c: hsl(var(--h) 85% 34%); background: linear-gradient(90deg, hsl(var(--h) 90% 50% / 0.12), transparent 70%); border-left-color: hsl(var(--h) 80% 42% / 0.7); }
  .slot-card li b { width: 1.1em; color: var(--c); font-variant-numeric: tabular-nums; font-size: 0.78rem; }
  .slot-card li.top { font-weight: 600; border-left-color: var(--c); background: linear-gradient(90deg, hsl(var(--h) 70% 55% / 0.26), transparent 85%); box-shadow: 0 0 16px -8px hsl(var(--h) 80% 55% / 0.6); }
  .slot-card li small { color: var(--muted); font-size: 0.72rem; font-weight: 400; margin-left: auto; text-align: right; }
  .slot-card li em { margin-left: auto; font-style: normal; font-weight: 600; font-size: 0.78rem; font-variant-numeric: tabular-nums; color: var(--c); }
  .slot-card li small + em { margin-left: 10px; min-width: 2.6em; text-align: right; }
  .slot-card li.rest { border-left-style: dashed; border-left-color: var(--line); background: none; color: var(--muted); font-size: 0.8rem; }

  .line { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .sub { display: block; margin-top: 10px; color: var(--muted); font-size: 0.8rem; line-height: 1.4; }
  .stones li { display: flex; align-items: center; gap: 12px; padding: 9px 12px; margin-bottom: 6px; border: 1px solid var(--line); border-left: 3px solid color-mix(in srgb, var(--warn) 45%, transparent); background: linear-gradient(90deg, color-mix(in srgb, var(--warn) 9%, transparent), transparent 75%); font-size: 0.92rem; }
  .stones li.first { font-weight: 600; border-left-color: var(--warn); background: linear-gradient(90deg, color-mix(in srgb, var(--warn) 24%, transparent), transparent 90%); box-shadow: 0 0 18px -9px var(--warn); }
  .stones em { margin-left: auto; font-style: normal; font-weight: 600; font-size: 0.82rem; font-variant-numeric: tabular-nums; color: var(--warn); }
  .stones b { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--warn) 55%, transparent); color: var(--warn); font-size: 0.78rem; font-variant-numeric: tabular-nums; }
  .path { position: relative; }
  .path li { position: relative; display: flex; gap: 14px; padding-bottom: 16px; }
  .path li:last-child { padding-bottom: 0; }
  .path li:not(:last-child)::before { content: ''; position: absolute; left: 15px; top: 34px; bottom: 2px; width: 2px; background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 60%, transparent), var(--line)); }
  .path b { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); color: var(--accent); font-variant-numeric: tabular-nums; }
  .path strong { display: block; margin-top: 5px; font-size: 1rem; }
  .path a.ext { display: inline-flex; align-items: center; gap: 7px; margin-top: 10px; padding: 5px 12px 5px 9px; border: 1px solid var(--line); border-radius: 3px; background: var(--panel); color: var(--accent); font-size: 0.86rem; font-weight: 600; text-decoration: none !important; }
  .path a.ext span { display: grid; place-items: center; line-height: 0; }
  .path a.ext svg { width: 16px; height: 16px; flex: none; display: block; }
  .path a.ext:hover { border-color: var(--accent); background: var(--accent-soft); }
  .head-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .legend { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 0.8rem; }
  .lost-ico { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; color: var(--warn); border: 1px solid color-mix(in srgb, var(--warn) 55%, transparent); background: color-mix(in srgb, var(--warn) 12%, transparent); position: relative; vertical-align: middle; }
  .lost-ico[data-tip]:hover::after, .lost-ico[data-tip]:focus::after { content: attr(data-tip); position: absolute; left: calc(100% + 4px); bottom: calc(100% + 4px); white-space: nowrap; z-index: 5; }
  .lost-ico svg { width: 12px; height: 12px; }
  .path strong .lost-ico { margin-left: 8px; }
  .levels { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 2px 0 4px; }
  .lv { color: var(--muted); font-size: 0.95rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .lv.top { color: var(--ok); }
  .gem { width: 26px; height: 26px; stroke-linejoin: round; filter: drop-shadow(0 0 3px rgba(80, 200, 215, 0.4)); }
  .gem path:nth-child(1) { fill: #3ba5b2; stroke: #12302f; stroke-width: 1.2; }
  .gem path:nth-child(2) { fill: #2c8d9c; stroke: #0a5361; stroke-width: 1.1; }
  .gem path:nth-child(3) { fill: #d8fcfc; stroke: none; }
  .arrow { color: var(--muted); }
  .path p { margin: 3px 0 7px; color: var(--muted); font-size: 0.84rem; line-height: 1.45; }
  .panel + .panel { margin-top: 20px; }
  .sources { text-align: right; margin-top: 16px; }
</style>
