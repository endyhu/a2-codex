---
import Base from '../../layouts/Base.astro';
import swords from 'lucide-static/icons/swords.svg?raw';
import crown from 'lucide-static/icons/crown.svg?raw';
import shield from 'lucide-static/icons/shield.svg?raw';
import shirt from 'lucide-static/icons/shirt.svg?raw';
import cloak from 'lucide-static/icons/ghost.svg?raw';
import hand from 'lucide-static/icons/hand.svg?raw';
import footprints from 'lucide-static/icons/footprints.svg?raw';
import gem from 'lucide-static/icons/gem.svg?raw';
import ear from 'lucide-static/icons/ear.svg?raw';
import ring from 'lucide-static/icons/circle-dot.svg?raw';
import play from 'lucide-static/icons/play.svg?raw';
import unlink from 'lucide-static/icons/unlink.svg?raw';
import arrowUp from 'lucide-static/icons/arrow-up.svg?raw';
import target from 'lucide-static/icons/target.svg?raw';

// Lines are in priority order. Every line below was checked against the random-stat pool of that slot's top Global gear
// (metabot.gg, Global client data; see docs/data-sources.md). Order is from the Aion 2 Bible. Its "Smite" is Double Chance,
// "Movement Speed" is Move Speed. Its Cloak "Perfect Chance" and its Brooch/Pendant are not on Global, so they are left out.
// Each line is [name, roll chance in %], the chance read from the item's random-stat table in the Global client data
// (identical across the top two tiers and across weapon types; the Guard matches too).
type Row = { slot: string; icon: string; lines: [string, number][]; skills?: string };
const lines: Row[] = [
  { slot: 'Weapon / Guard', icon: swords, lines: [['Damage Boost', 2], ['Combat Speed', 4], ['Weapon Damage Boost', 4], ['Might', 6], ['Multi-hit Chance', 6], ['Precision', 7], ['Attack', 7]] },
  { slot: 'Helm', icon: crown, lines: [['Double Chance', 1.2], ['Attack Increase', 1.2], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Pauldrons', icon: shield, lines: [['Double Chance', 1.2], ['Critical Damage Boost', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Top', icon: shirt, lines: [['Perfect Chance', 1.2], ['Damage Boost', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Cloak', icon: cloak, lines: [['Double Chance', 1.2], ['Attack Increase', 1.2], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Gloves', icon: hand, lines: [['Perfect Chance', 1.2], ['Combat Speed', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Legs', icon: footprints, lines: [['Attack Increase', 1.2], ['Perfect Chance', 1.2], ['Damage Tolerance', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Shoes', icon: footprints, lines: [['Perfect Chance', 1.2], ['Move Speed', 3], ['Attack', 4]], skills: 'Passive skills' },
  { slot: 'Earrings', icon: ear, lines: [['Attack', 6], ['Accuracy', 6]], skills: 'Passive skills' },
  { slot: 'Necklace', icon: gem, lines: [['Attack', 6], ['Accuracy', 6]], skills: 'Passive skills' },
  { slot: 'Ring', icon: ring, lines: [['Might', 2], ['Precision', 2], ['Attack', 6]], skills: 'Active skills' },
];
// Tint per stat family: damage multipliers red, Attack amber, speed cyan, attributes violet, survivability green.
const hueOf = (n: string) =>
  /Speed/.test(n) ? 195 : /^(Might|Precision|Accuracy)$/.test(n) ? 280 : /Tolerance/.test(n) ? 150 : n === 'Attack' ? 38 : 8;
// Roll chance per roll on a Superior Manastone, from the Global client data (metabot.gg Manastone guide). Attack is 10% on every regular stone.
const manastones: [string, number][] = [['Front / Back Attack Damage Boost', 0.5], ['Weapon Damage Boost', 0.5], ['Critical Damage Boost', 0.5], ['Damage Boost', 0.5], ['Attack', 10]];
// Manastone slots by gear grade, and how each stone is obtained (metabot.gg gear enhancement guide, Global client data).
const slotsByGrade: [string, number][] = [['Common', 1], ['Rare', 2], ['Epic', 3], ['Unique', 4]];
const stoneGrades: [string, string][] = [['Lesser', 'Drops from monsters in Verteron, Altgard and Chaotic Lower Reshanta.'], ['Intermediate', '5 Lesser, 3 Spiritstone Powder, 2 Professional Ink (mastery 20).'], ['Superior', '30 Intermediate, 10 Spiritstone Powder, 2 Exceptional Ink (mastery 85).']];
const stepId = (t: string) => `step-${t.toLowerCase().replace(/ /g, '-')}`;
const lostTip = 'Lost on transfer';
// Global client data (metabot.gg gear enhancement guide and calculator): Unique gear is guaranteed to +10, then 65/50/35/25/20% with +5% pity per failure.
// Amplified Enhancement goes past +15, up to +5 depending on item level. Soul Binding has 10 steps. Potential is PvP only.
const gemSvg = '<svg class="gem" viewBox="0 0 24 24"><path d="M12 1.5Q16.5 7.5 22.5 12Q16.5 16.5 12 22.5Q7.5 16.5 1.5 12Q7.5 7.5 12 1.5Z" /><path d="M12 5.2Q14.8 9.2 18.8 12Q14.8 14.8 12 18.8Q9.2 14.8 5.2 12Q9.2 9.2 12 5.2Z" /><path d="M12 8.8Q13.2 10.8 15.2 12Q13.2 13.2 12 15.2Q10.8 13.2 8.8 12Q10.8 10.8 12 8.8Z" /></svg>';
const gemRow = (n: number) => Array.from({ length: 5 }, (_, i) => (i < n ? gemSvg : gemSvg.replace('class="gem"', 'class="gem off"'))).join('');
const enhanceRates: [string, number][] = [['+15', 20], ['+14', 25], ['+13', 35], ['+12', 50], ['+11', 65], ['+1 to +10', 100]];
// Average tries per level: each failure adds 5% to the next try on that level (pity), assumed to reset after a success.
const avgTries = (p: number, pity = 0.05) => { let e = 0, s = 1; for (let k = 0; k < 40; k++) { e += s; s *= 1 - Math.min(1, p + pity * k); } return e; };
const totalTries = enhanceRates.filter(([, p]) => p < 100).reduce((n, [, p]) => n + avgTries(p / 100), 0);
// Kinah per try, level 36 vs level 86 Unique gear (Aion 2 community Reddit post; the level 86 figures match the per-try costs in the video guide).
const step0to10: [number, number] = [304900, 775100]; // sum of the ten +0 to +10 steps, all guaranteed
const stepCosts: [string, number, number][] = [['+10 → +11', 127000, 310000], ['+11 → +12', 188000, 450000], ['+12 → +13', 302000, 720000], ['+13 → +14', 480000, 1130000], ['+14 → +15', 660000, 1570000]];
const tryRows: [string, number, number][] = [['+0 → +10 (always works)', ...step0to10], ...stepCosts];
const oneEach = tryRows.reduce<[number, number]>((t, [, a, b]) => [t[0] + a, t[1] + b], [0, 0]);
// Average with failures and pity, to +15 (metabot.gg gear enhancement guide, Global client data).
const avgTo15: [number, number] = [5310000, 12600000];
const fmt = (n: number) => n.toLocaleString('en-US');
const pctLess = (a: number, b: number) => Math.round(((b - a) / b) * 100);
// Amplify costs from the Global client data (metabot.gg gear enhancement calculator). Only the first and fifth diamond are published per try.
// Per diamond: chance, pity added per failure (points), cost per try (metabot.gg gear enhancement guide, Global client data). Same for every item level that reaches that diamond.
const ampSteps: [string, number, number, string, string][] = [['1st', 66, 5, '600,000', '6'], ['2nd', 50, 4, '900,000', '9'], ['3rd', 33, 3, '1,400,000', '12'], ['4th', 25, 2, '2,000,000', '15'], ['5th', 20, 1, '3,000,000', '20']];
const ampTries = ampSteps.reduce((n, r) => n + avgTries(r[1] / 100, r[2] / 100), 0);
// Stats Amplify adds at 5 diamonds, per gear type (Aion 2 Bible, community guide). Per-diamond values are not published.
const ampStats: { type: string; stats: [string, string][] }[] = [
  { type: 'Weapon', stats: [['Attack', '+150'], ['Attack Increase', '+5%']] },
  { type: 'Armor', stats: [['Defense & HP', '+400'], ['Defense & HP Increase', '+5%']] },
  { type: 'Accessories', stats: [['Attack', '+100'], ['Defense', '+200'], ['Attack Increase', '+5%']] },
];
// Soul Binding on Unique gear: Kinah and Soul Codex per Bind step (metabot.gg enhancement calculator, Global client data).
const bindSteps: [number, number][] = [[30000, 10], [42000, 12], [59000, 16], [83000, 21], [117000, 27], [164000, 36], [230000, 46], [322000, 60], [451000, 78], [632000, 102]];
const bindTotal = bindSteps.reduce<[number, number]>((t, [k, c]) => [t[0] + k, t[1] + c], [0, 0]);
// Item level -> diamonds a piece can get (Splendent gear: 70 gets 1, 86 gets 3).
const ampSlots: [string, number][] = [['below 54', 0], ['54', 1], ['70 and 78', 3], ['86 and up', 5]];
type Step = { actions?: [string, string][]; trick?: { title: string; flow: [string, string][]; notes: string[] }; text?: string[]; t: string; d: string; facts: [string, string][]; link?: { label: string; href: string }; lost?: boolean; vis?: 'enhance' | 'amp' | 'soul' | 'mana' | 'theo' | 'pot' };
const order: Step[] = [
  { t: 'Enhance', vis: 'enhance', d: '', facts: [],
    text: ['Raises a piece from +1 to +15 and its base stats with it. Each try costs Kinah and Enhance Stones.',
      'Up to +10 always works. From +11 each try can fail, and the chance drops with every level.',
      'A failure costs the materials but never loses a level, and your next try on that level gets +5%. That is why the average tries are lower than 1 divided by the chance.',
      'Do your weapon before armor, since it carries the Attack gain.'],
    trick: { title: 'Cheaper route: level a low-level piece, then transfer it',
      flow: [['Buy', 'A level 36 Unique piece of the same slot from the Marketplace, about 300K to 1.2M Kinah depending on the server'], ['Roll', 'Right-click it to roll four lines at once. Buy more until two lines you want land'], ['Enhance', 'Take it to +15 while it is still cheap'], ['Transfer', 'Transfer menu: target is the gear you keep, source is the cheap piece. Level 36 to level 86 takes 2 Unique Transfer Stones and always succeeds']],
      notes: ['Transfer moves the Soul Binding lines and the enhancement level.',
        'Each piece you buy rolls four lines. Re-rolling one line at a time with a Sync item costs far more.',
        'Already +15: leave it alone. Already +10 with bad lines: do not re-roll single lines, transfer in a cheap piece that has one or two lines you want. Losing the old +10 costs about 1M Kinah and a few thousand stones, which is minor next to the right lines.',
        'Always take the source piece to +15 before transferring.'] } },
  { t: 'Amplify', vis: 'amp', d: '', facts: [],
    text: ['Only after +15. Pushes a Unique piece further, and the game shows it as diamonds instead of +x.',
      'Every diamond is a chance. The odds start at 66% and fall to 20% by the fifth. A failure burns the materials but never loses a diamond, and your next try on that diamond gets a bonus that shrinks with each diamond.',
      'Each try costs Kinah and Amplify Stones, and the price climbs with every diamond.',
      'How many diamonds a piece can get depends on its item level, shown on the right.'] },
  { t: 'Soul Binding', vis: 'soul', d: '', facts: [],
    text: ['Soul Binding is where a piece gets its main stat lines. Each line is random, drawn from a pool for that type of piece: all helmets share one pool, all weapons share one.',
      'Binding a piece raises its binding rate over 10 steps, which strengthens every line. A step always works, but how much it adds is random. Each line has its own bar, and the rate reads 100% once every line is full. Reaching 100% unlocks an extra Manastone slot.',
      'Bind only raises values. To change which lines you have, use Sync or Reset, or bind a fresh piece and transfer it.'],
    actions: [['Bind', 'A new piece rolls four random lines when you bind it. Further steps cost Kinah and Soul Codex.'], ['Sync', 'Re-rolls one line, so it suits a piece with most lines right. Costs a Synch Stone or a Unique piece of gear, of the same grade or higher. Synch Stones come from morphing fragments (mainly dungeons) or from any Unique gear piece.'], ['Reset', 'Re-rolls every line at once, so it suits a piece with most lines wrong. Costs an orange Soul Codex: Reset book.'], ['Transfer', 'Moves the lines onto another piece, so a lucky roll is not stuck on gear you replace. Level 36 to level 86 takes 2 Unique Transfer Stones.']] },
  { t: 'Manastones', vis: 'mana', d: '', facts: [], lost: true,
    text: ['Random stat lines engraved into the Manastone slots of a piece. Do this after enhancing.',
      'Use Lesser stones on gear you only wear to raise item level, and Superior stones on gear you keep. Manastones do not transfer, so do not go all in on gear you will replace.',
      'The four Damage Boost lines only roll on Superior stones. Weapon Damage Boost and Critical Damage Boost are close. Two yellow Attack lines roughly equal one yellow Damage Boost line, and one yellow Attack is a fine placeholder.'] },
  { t: 'Theostone', vis: 'theo', d: '', facts: [], lost: true,
    text: ['A weapon and Guard engraving that can proc when you attack. In PvE it adds only about 1% damage, so do not chase it. Pick whichever looks nicest.',
      "In PvP a control stone is worth having, because a Stun in a fight matters more than damage. Meslamtaeda's Greed has a 3% chance to Stun for 3s."],
    link: { label: 'Watch Theostone previews', href: 'https://www.youtube.com/shorts/MyBzybv75u8' } },
  { t: 'Potential', vis: 'pot', d: 'Adds PvP stats only. Skip it if you only do PvE, and level it only on a piece you keep.',
    facts: [['Weapon, accessories', '+2% PvP Damage Boost at +4'], ['Armor', 'PvP Damage Tolerance'], ['Cost', '10 Potential Stones, 400,000 Abyss Points'], ['Success chance', '100%, it never fails']], lost: true },
];
---
<Base title="Gear" description="Best stat lines per slot, Manastones, enhancement order, for AION 2 Global.">
  <h1 class="page-title">Gear</h1>

  <section class="panel" id="best-lines" aria-label="Best stat lines per slot">
    <header class="panel-head"><h2>Best stat lines</h2></header>
    <div class="cards">
      {lines.map((r) => (
        <article class="slot-card">
          <header><span class="ico" set:html={r.icon} /><strong>{r.slot}</strong></header>
          <ol>
            {r.lines.map(([l, p], i) => <li class={i === 0 ? 'top' : ''} style={`--h:${hueOf(l)}`}><b>{i + 1}</b>{l}<em>{p}%</em></li>)}
            {r.skills && <li class="rest">{r.skills} for the rest</li>}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <div class="enh-layout">
  <div class="rail-track"><div class="rail" role="navigation" aria-label="Enhancement steps">
    {order.map((o, i) => <a href={`#${stepId(o.t)}`} data-step={stepId(o.t)} title={o.t}><b>{i + 1}</b><span class="lbl">{o.t}</span></a>)}
    <button class="top-btn" type="button" title="Back to top" aria-label="Back to top"><span set:html={arrowUp} /><span class="lbl">Back to top</span></button>
  </div></div>
  <section class="panel" aria-label="Enhancement order">
    <header class="panel-head head-row"><h2>Enhancement order</h2><span class="legend"><span class="lost-ico" set:html={unlink} />Lost on transfer</span></header>
    <ol class="path">
      {order.map((o, i) => (
        <li id={stepId(o.t)}>
          <b>{i + 1}</b>
          <div class="step">
            <strong>{o.t}{o.lost && <span class="lost-ico" tabindex="0" role="img" aria-label={lostTip} data-tip={lostTip} set:html={unlink} />}</strong>
            {o.vis === 'enhance' ? (
              <div class="enh">
                <div class="enh-text">{o.text!.map((t) => <p>{t}</p>)}</div>
                <div class="ladder" aria-label="Success chance per level">{enhanceRates.map(([l, p]) => <div class={p === 100 ? 'rung sure' : 'rung'} style={`--p:${p}%`}><span class="lvl">{l}</span><span class="bar"><span class="fill" /></span><span class="pct">{p + '%'}</span><span class="tries">{p === 100 ? '1 try' : '~' + avgTries(p / 100).toFixed(1) + ' tries'}</span></div>)}<div class="rung-total"><span>+10 → +15 average</span><b>~{Math.round(totalTries)} tries</b></div></div>
              </div>
            ) : o.d ? <p>{o.d}</p> : null}
            {o.trick && <div class="trick"><strong>{o.trick.title}</strong><ol class="flow">{o.trick.flow.map(([t, d], i) => <li><b>{String(i + 1).padStart(2, '0')}</b><strong>{t}</strong><span>{d}</span></li>)}</ol><table class="saving"><caption>Kinah per try, enhancing to +15</caption><thead><tr><th>Step</th><th>Level 36</th><th>Level 86</th><th>You save</th></tr></thead><tbody>{tryRows.map(([l, c, d]) => <tr><th>{l}</th><td>{fmt(c)}</td><td>{fmt(d)}</td><td class="gain">{fmt(d - c)}</td></tr>)}</tbody><tfoot><tr class="sum"><th>One try per step</th><td>{fmt(oneEach[0])}</td><td>{fmt(oneEach[1])}</td><td class="gain">{fmt(oneEach[1] - oneEach[0])} <small>({pctLess(oneEach[0], oneEach[1])}% less)</small></td></tr><tr class="sum big"><th>Average with failures</th><td>{(avgTo15[0] / 1e6).toFixed(1)}M</td><td>{(avgTo15[1] / 1e6).toFixed(1)}M</td><td class="gain">{((avgTo15[1] - avgTo15[0]) / 1e6).toFixed(1)}M <small>({pctLess(avgTo15[0], avgTo15[1])}% less)</small></td></tr></tfoot></table><ul class="trick-notes">{o.trick.notes.map((n) => <li>{n}</li>)}</ul></div>}
            {o.vis === 'amp' && (
              <div class="enh">
                <div class="enh-text">{o.text!.map((t) => <p>{t}</p>)}
                  <table class="saving amp-cost"><caption>Odds and cost per try</caption><thead><tr><th>Diamond</th><th>Chance</th><th>Pity</th><th>Avg tries</th><th>Kinah</th><th>Stones</th></tr></thead><tbody>{ampSteps.map(([l, c, d, k, st], i) => <tr><th><span class="lbl">{l}</span></th><td>{c}%</td><td>+{d}%</td><td>~{avgTries(c / 100, d / 100).toFixed(1)}</td><td>{k}</td><td>{st}</td></tr>)}</tbody><tfoot><tr class="sum big"><th>All five, average</th><td></td><td></td><td>~{Math.round(ampTries)}</td><td>~26M</td><td>~196</td></tr></tfoot></table>
                </div>
                <div class="ladder" aria-label="Diamonds by item level">
                  <div class="rung-head"><span class="lv top">+15</span><span class="arrow">→</span><span class="gems" set:html={gemSvg.repeat(5)} /></div>
                  {ampSlots.map(([l, n]) => <div class="amp-row"><span>Item level {l}</span><span class="gems" role="img" aria-label={`${n} of 5`} set:html={gemRow(n)} /></div>)}
                  <div class="amp-stats"><h4>Stats at 5 diamonds</h4>{ampStats.map((g) => <div class="amp-type"><strong>{g.type}</strong>{g.stats.map(([n, v]) => <p style={`--h:${hueOf(n)}`}><span>{n}</span><b>{v}</b></p>)}</div>)}</div>
                </div>
              </div>
            )}
            {o.vis === 'soul' && (
              <div class="enh">
                <div class="enh-text">{o.text!.slice(0, -1).map((t) => <p>{t}</p>)}
                  <div class="text-btn"><p>{o.text![o.text!.length - 1]}</p>
                    <a class="bsl" href="#best-lines"><span class="bsl-ico" set:html={target} /><span class="bsl-text"><strong>Best stat lines</strong></span><span class="bsl-go" set:html={arrowUp} /></a>
                  </div>
                  <dl class="actions">{o.actions!.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
                </div>
                <table class="saving bind" aria-label="Bind cost per step">
                  <caption>Bind cost per step, Unique gear</caption>
                  <thead><tr><th>Step</th><th>Kinah</th><th>Soul Codex</th></tr></thead>
                  <tbody>{bindSteps.map(([k, c], i) => <tr><th>{i + 1}</th><td>{fmt(k)}</td><td>{c}</td></tr>)}</tbody>
                  <tfoot><tr class="sum big"><th>All 10</th><td>{fmt(bindTotal[0])}</td><td>{bindTotal[1]}</td></tr></tfoot>
                </table>
              </div>
            )}
            {o.vis === 'mana' && (
              <div class="enh">
                <div class="enh-text">{o.text!.map((t) => <p>{t}</p>)}
                  <h4 class="mini">Slots by gear grade</h4>
                  <div class="slots">{slotsByGrade.map(([g, n]) => <div><span>{g}</span><span class="dots" role="img" aria-label={`${n} slots`}>{Array.from({ length: n }, () => <i />)}{g === 'Unique' && <i class="extra" title="Extra slot at 100% Soul Binding" />}</span></div>)}</div>
                  <h4 class="mini">Stone grades</h4>
                  <dl class="actions wide">{stoneGrades.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
                </div>
                <div class="stones" aria-label="Chance per roll">
                  <h4>Roll order, chance per roll on a Superior stone</h4>
                  {manastones.map(([n, c], i) => <div class={i === 0 ? 'stone first' : 'stone'}><b>{i + 1}</b><span>{n}</span><em>{c}%</em></div>)}
                </div>
              </div>
            )}
            {o.vis === 'theo' && (
              <div class="theo">
                {o.text!.map((t) => <p>{t}</p>)}
                {o.link && <a class="ext" href={o.link.href} target="_blank" rel="noopener"><span class="play" set:html={play} /><span class="lbl">{o.link.label}<small>Video</small></span></a>}
              </div>
            )}
            {o.vis === 'pot' && <table class="saving pot"><tbody>{o.facts.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody></table>}
            {o.link && o.vis !== 'theo' && <a class="ext" href={o.link.href} target="_blank" rel="noopener"><span set:html={play} />{o.link.label}</a>}
          </div>
        </li>
      ))}
    </ol>
  </section>
  </div>

  <p class="meta sources">Lines and roll chances from Global client data (<a href="https://metabot.gg/en/aion-2/items">metabot.gg</a>). Enhancement, Soul Binding, Potential and Manastone chances: Global client data (<a href="https://metabot.gg/en/aion-2/guides/gear-enhancement-guide">metabot.gg</a>). Level 36 vs 86 enhancement costs and the transfer route: community posts. Line and Manastone order: <a href="https://www.aion2bible.com">Aion 2 Bible</a>, a community guide.</p>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.rail a')];
  const side = [...document.querySelectorAll<HTMLAnchorElement>('#side .child')];
  const rail = document.querySelector('.rail')!;
  const sections = ['best-lines', ...links.map((a) => a.dataset.step!)].map((id) => document.getElementById(id)!).filter(Boolean);
  const ids = sections.map((el) => el.id);
  // A clicked link stays highlighted (the last sections cannot scroll up to the trigger line) until the reader scrolls on their own.
  let pinned: string | null = ids.includes(location.hash.slice(1)) ? location.hash.slice(1) : null;
  const mark = () => {
    let id = pinned;
    if (!id) {
      // The bar only pushes the trigger line down while it is stuck to the top of the screen.
      const r = rail.getBoundingClientRect();
      const bar = matchMedia('(max-width: 1799px)').matches && r.top <= parseFloat(getComputedStyle(rail).top) + 1 ? r.bottom : 0;
      const line = bar + innerHeight * 0.3;
      let current: HTMLElement | undefined;
      for (const el of sections) if (el.getBoundingClientRect().top <= line) current = el;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = sections[sections.length - 1];
      id = current?.id ?? null;
    }
    links.forEach((a) => a.classList.toggle('on', a.dataset.step === id));
    side.forEach((a) => a.classList.toggle('on', a.dataset.hash === id));
  };
  const unpin = () => { if (pinned) { pinned = null; mark(); } };
  // Short glow on the section a link jumps to, started once the scroll has settled.
  const glow = (id: string) => {
    const section = document.getElementById(id);
    const el = id === 'best-lines' ? section : section?.querySelector<HTMLElement>('.step');
    if (!el) return;
    let done = false;
    const run = () => {
      if (done) return;
      done = true;
      el.classList.remove('flash');
      void el.offsetWidth;
      el.classList.add('flash');
      setTimeout(() => el.classList.remove('flash'), 1700);
    };
    addEventListener('scrollend', run, { once: true });
    setTimeout(run, 900);
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    const hash = a ? new URL(a.href).hash.slice(1) : '';
    if (a && ids.includes(hash) && new URL(a.href).pathname === location.pathname) { pinned = hash; mark(); glow(hash); }
