---
import Base from '../../layouts/Base.astro';
import layoutGrid from 'lucide-static/icons/layout-grid.svg?raw';import swords from 'lucide-static/icons/swords.svg?raw';import shield from 'lucide-static/icons/shield.svg?raw';import gem from 'lucide-static/icons/gem.svg?raw';import flask from 'lucide-static/icons/flask-conical.svg?raw';import pickaxe from 'lucide-static/icons/pickaxe.svg?raw';import shirt from 'lucide-static/icons/shirt.svg?raw';import ellipsis from 'lucide-static/icons/ellipsis.svg?raw';

const sections: [string, string, string][] = [['all', 'All', layoutGrid], ['weapons', 'Weapons', swords], ['armor', 'Armor', shield], ['accessories', 'Accessories', gem], ['consumables', 'Consumables', flask], ['materials', 'Materials', pickaxe], ['skins', 'Skins', shirt], ['other', 'Other', ellipsis]];
const factions: [string, string][] = [['all', 'Both'], ['Elyos', 'Elyos'], ['Asmodian', 'Asmodian']];
---
<Base title="Market" description="Cheapest and most expensive server for every AION 2 Global market item.">
  <h1 class="page-title">Market</h1>

  <div class="mkt">
    <section class="panel" id="filters" aria-label="Filters">
      <header class="panel-head"><h2>Filters</h2></header>

      <h3 class="mini">Region</h3>
      <div class="togs" id="region" role="radiogroup" aria-label="Region"></div>

      <h3 class="mini">Faction</h3>
      <div class="togs seg" id="faction" role="radiogroup" aria-label="Faction">
        {factions.map(([v, l]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v} style={v === "all" ? "" : `--h:${v === "Elyos" ? 200 : 290}`}>{v !== "all" && <i class="dot" />}{l}</button>)}
      </div>

      <h3 class="mini">Servers</h3>
      <div class="togs seg" id="launch" role="radiogroup" aria-label="Server launch">{[["launch", "Launch"], ["ea", "Early Access"], ["all", "Both"]].map(([v, l]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v}>{l}</button>)}</div>

      <h3 class="mini">Server</h3>
      <select id="server" class="num" aria-label="Server"><option value="0">All servers</option></select>

      <h3 class="mini">Type</h3>
      <div class="togs wrap" id="section" role="radiogroup" aria-label="Type">
        {sections.map(([v, l, ic]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v}><span class="ico" set:html={ic} />{l}</button>)}
      </div>

      <h3 class="mini">Listings per server</h3>
      <div class="togs seg" id="minl" role="radiogroup" aria-label="Minimum listings per server">{[["1", "Any"], ["3", "3+"], ["5", "5+"], ["10", "10+"]].map(([v, l]) => <button type="button" class="tog" role="radio" aria-checked="false" data-v={v}>{l}</button>)}</div>
    </section>

    <section class="panel" id="prices" aria-label="Prices">
      <header class="panel-head"><h2>Prices by server</h2><span class="status" id="status">Loading</span></header>
      <div class="bar"><input id="q" class="num search" type="search" placeholder="Search items" autocomplete="off" aria-label="Search items" /><button type="button" class="tog" id="vol" data-sort="vol" aria-pressed="true">Most traded</button></div>
      <div class="scroll" id="scroll">
      <table class="saving mk" id="table" hidden>
        <thead>
          <tr>
            <th scope="col"><button type="button" data-sort="name">Item</button></th>
            <th scope="col"><button type="button" data-sort="min">Cheapest</button></th>
            <th scope="col"><button type="button" data-sort="max">Most expensive</button></th>
            <th scope="col"><button type="button" data-sort="spread">Gap</button></th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      </div>
      <p class="empty" id="empty" hidden>No item is listed on two or more of these servers.</p>
    </section>
  </div>

  <p class="meta sources">Prices: the cheapest listed unit price per item and server, from the <a href="https://aion2.exchange/">Aion2Market</a> public API, which collects the in-game market every hour. This page is rebuilt from a fresh snapshot every 6 hours.</p>
</Base>

<style is:global>
  main { max-width: 1500px; }
  .mkt { display: grid; grid-template-columns: 340px minmax(0, 1fr); align-items: start; gap: 20px; }
  .mkt > .panel + .panel { margin-top: 0; }
  .mkt .panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .mkt .status { color: var(--muted); font-size: 0.84rem; font-variant-numeric: tabular-nums; }
  .mkt .togs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .mkt .togs.wrap { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .mkt .wrap .tog { display: flex; align-items: center; justify-content: flex-start; gap: 9px; padding: 6px 10px; text-align: left; background: var(--panel); border: 1px solid var(--line); border-radius: 3px; font-size: 0.82rem; font-weight: 600; cursor: pointer; }
  .mkt .wrap .tog:hover, .mkt .wrap .tog:focus-visible { background: var(--panel-2); border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .mkt .wrap .tog:hover .ico, .mkt .wrap .tog:focus-visible .ico { color: var(--text); }
  .mkt .wrap .ico { display: inline-flex; align-items: center; color: var(--muted); transition: color 0.15s; }
  .mkt .wrap .ico svg { display: block; width: 15px; height: 15px; }
  .mkt .wrap .tog[aria-checked='true'] { border-color: color-mix(in srgb, var(--accent) 70%, transparent); background: radial-gradient(120% 140% at 0% 0%, var(--accent-soft), var(--panel) 70%); box-shadow: 0 0 14px -8px var(--accent); }
  .mkt .wrap .tog[aria-checked='true'] .ico { color: var(--accent); }
  #faction, #launch { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  #minl { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .mkt .tog { min-width: 0; padding: 5px 4px; text-align: center; font-size: 0.82rem; font-weight: 600; line-height: 1.4; background: var(--panel); border: 1px solid var(--line); border-radius: 3px; color: var(--muted); cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .mkt .tog:hover, .mkt .tog:focus-visible { border-color: color-mix(in srgb, var(--accent) 55%, transparent); color: var(--text); outline: none; }
  .mkt .tog[aria-checked='true'] { color: var(--text); border-color: color-mix(in srgb, var(--accent) 70%, transparent); background: radial-gradient(120% 140% at 0% 0%, var(--accent-soft), var(--panel) 70%); }
  .mkt .num { width: 100%; padding: 6px 8px; background: var(--bg); border: 1px solid var(--line); border-radius: 3px; color: var(--text); font: inherit; font-variant-numeric: tabular-nums; transition: border-color 0.15s; }
  .mkt .num:focus-visible { border-color: var(--accent); outline: none; }
  .mkt .seg { gap: 0; border: 1px solid var(--line); border-radius: 3px; overflow: hidden; }
  .mkt .seg .tog { border: 0; border-radius: 0; }
  .mkt .seg .tog + .tog { border-left: 1px solid var(--line); }
  .mkt .seg .tog[aria-checked='true'] { background: radial-gradient(120% 140% at 0% 0%, var(--accent-soft), var(--panel) 70%); box-shadow: inset 0 -2px 0 var(--accent); }
  .mkt .dot { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: hsl(var(--h) 75% 60%); vertical-align: 1px; }
  .mkt #region .tog { padding: 7px 6px 6px; }
  .mkt #region .tog small { display: block; margin-top: 1px; color: var(--muted); font-size: 0.7rem; font-weight: 500; }
  .mkt .mini { margin: 22px 0 8px; }
  .mkt .mini:first-of-type { margin-top: 0; }
  .mkt .bar { display: flex; gap: 8px; margin-bottom: 10px; }
  .mkt .bar .search { flex: 1; min-width: 0; }
  .mkt .bar .tog { flex: none; padding: 5px 14px; }
  .mkt .bar .tog[aria-pressed='true'] { color: var(--text); border-color: color-mix(in srgb, var(--accent) 70%, transparent); background: radial-gradient(120% 140% at 0% 0%, var(--accent-soft), var(--panel) 70%); }

  .mkt #prices { display: flex; flex-direction: column; }
  .scroll { overflow-y: auto; max-height: calc(100vh - 300px); min-height: 280px; overscroll-behavior: contain; }
  .scroll { padding-right: 4px; }
  .scroll thead th { position: sticky; top: 0; z-index: 1; background: var(--panel); box-shadow: 0 1px 0 var(--line); }
  .mkt > .panel:first-child { position: sticky; top: 16px; }
  .mk { table-layout: fixed; width: 100%; }
  .mk th:nth-child(2), .mk th:nth-child(3) { width: 22%; }
  .mk th:nth-child(4) { width: 9em; }
  .mk td, .mk tbody th { overflow-wrap: anywhere; }
  .mk thead th button { all: unset; cursor: pointer; color: inherit; font: inherit; }
  .mk thead th button:hover, .mk thead th button:focus-visible { color: var(--text); }
  .mk thead th[aria-sort] button { color: var(--accent); }
  .mk thead th[aria-sort='ascending'] button::after { content: ' ↑'; }
  .mk thead th[aria-sort='descending'] button::after { content: ' ↓'; }
  .mk tbody tr.mrow { cursor: pointer; }
  .mk tbody tr.mrow:hover, .mk tbody tr.mrow:focus-within, .mk tbody tr.mrow[data-open='true'] { background: var(--panel-2); }
  .mk .nb { display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .mk .nb:focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; border-radius: 3px; }
  .mk tbody th { text-transform: none; letter-spacing: normal; font-size: inherit; color: var(--text); text-align: left; }
  .mk td b, .mk th b { display: block; font-weight: 600; }
  .mk small { display: block; color: var(--muted); font-weight: 400; opacity: 1; }
  .mk td.diff { white-space: nowrap; overflow-wrap: normal; font-weight: 700; }
  .mk td.diff small { color: var(--muted); font-weight: 400; }
  .mk tr.detail > td { padding: 0; background: var(--panel); }
  .mk tr.detail > td { border-bottom: 1px solid var(--line); }
  .mk .sv { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 4px 20px; padding: 10px 12px 12px; text-align: left; }
  .mk .sr { position: relative; display: grid; grid-template-columns: 1.6em minmax(0, 1fr) auto 5.2em 3.6em; align-items: center; gap: 10px; padding: 5px 8px; border-radius: 3px; font-size: 0.84rem; font-variant-numeric: tabular-nums; overflow: hidden; }
  .mk .sr::before { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--w); background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 5%, transparent), color-mix(in srgb, var(--accent) 20%, transparent)); border-right: 2px solid color-mix(in srgb, var(--accent) 55%, transparent); }
  .mk .sr > * { position: relative; }
  .mk .sr.lo::before { background: linear-gradient(90deg, color-mix(in srgb, var(--ok) 5%, transparent), color-mix(in srgb, var(--ok) 24%, transparent)); border-right-color: var(--ok); }
  .mk .sr.me { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 70%, transparent); }
  .mk td.diff.best { color: var(--ok); }
  .mk td.diff.over { color: var(--warn); }
  .mkt select.num { cursor: pointer; }
  .mk .sr.hi::before { background: linear-gradient(90deg, color-mix(in srgb, var(--warn) 5%, transparent), color-mix(in srgb, var(--warn) 22%, transparent)); border-right-color: var(--warn); }
  .mk .sr .rk { color: var(--muted); font-size: 0.74rem; text-align: center; }
  .mk .sr .nm { display: flex; align-items: center; gap: 7px; min-width: 0; font-weight: 600; }
  .mk .sr .nm span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mk .sr .dot { margin-right: 0; flex: none; }
  .mk .sr .pr { text-align: right; font-weight: 700; }
  .mk .sr.lo .pr { color: var(--ok); }
  .mk .sr .ls { text-align: right; color: var(--muted); font-size: 0.76rem; }
  .mk .sr .up { text-align: right; color: var(--muted); font-size: 0.76rem; }
  .mk .sr.hi .up { color: var(--warn); }
  @media (max-width: 480px) { .mk .sr { grid-template-columns: 1.4em minmax(0, 1fr) auto 4em; gap: 6px; padding: 5px 4px; } .mk .sr .ls, .mk .sr small { display: none; } .mk .sr .up { text-align: right; } }
  .mkt .empty { color: var(--muted); margin: 14px 0; }
  @media (max-width: 1100px) { .mkt { grid-template-columns: minmax(0, 1fr); } .mkt > .panel:first-child { position: static; } }
  @media (max-width: 600px) {
    .mk { display: table; font-size: 0.78rem; }
    .mk th, .mk td { padding: 6px 4px; }
    .mk th:nth-child(2), .mk th:nth-child(3) { width: 27%; }
    .mk th:nth-child(4) { width: 4.6em; }
  }
</style>

<script>
  type Server = [number, string, string, string, string, string, number];
  type Market = { generated: string; servers: Server[]; items: [number, string, string, string, number][]; prices: Record<string, number[]> };
  type Saved = { region: string; faction: string; launch: string; section: string; minl: number };
  type Row = { key: number; name: string; cat: string; vol: number; me: number; list: { s: Server; price: number; n: number }[]; min: number; max: number; spread: number };
  const STORE = 'a2codex-market-v1';
  const nf = new Intl.NumberFormat('en-US');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  let cache: Promise<Market> | null = null;
  const load = () => (cache ??= fetch('/market.json').then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); }).catch((e) => { cache = null; throw e; }));
  const kin = (n: number) => (n >= 1e9 ? `${+(n / 1e9).toFixed(1)}B` : n >= 1e6 ? `${+(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}K` : String(n));
  const pct = (x: number) => (x >= 100 ? '9,999%+' : `${x >= 0.1 ? Math.round(x * 100) : (x * 100).toFixed(1)}%`);
  const ago = (iso: string) => {
    const m = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000));
    return m < 60 ? `${m} min ago` : m < 2880 ? `${Math.round(m / 60)} h ago` : `${Math.round(m / 1440)} days ago`;
  };

  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('prices')) return;
    const ac = new AbortController();
    const { signal } = ac;
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const table = $<HTMLTableElement>('#table'), rowsEl = $('#rows'), status = $('#status'), empty = $('#empty');
    const q = $<HTMLInputElement>('#q');

    let saved: Partial<Saved> = {};
    try { saved = JSON.parse(localStorage.getItem(STORE) || '{}') || {}; } catch {}
    const state = { server: 0, region: saved.region || '', faction: saved.faction || 'all', launch: saved.launch || 'launch', section: saved.section || 'all', minl: [1, 3, 5, 10].reduce((a, v) => (v <= (saved.minl || 3) ? v : a), 1), q: '', sort: 'vol', dir: -1};
    const open = new Set<number>();
    let data: Market, rows: Row[] = [], regionsEl = () => {};

    const checked = (id: string, v: string) => document.querySelectorAll<HTMLElement>(`#${id} [data-v]`).forEach((b) => b.setAttribute('aria-checked', String(b.dataset.v === v)));
    const persist = () => { try { localStorage.setItem(STORE, JSON.stringify({ region: state.region, faction: state.faction, launch: state.launch, section: state.section, minl: state.minl })); } catch {} };

    const pick = (s: Server) => s[2] === state.region && (state.faction === 'all' || s[4] === state.faction) && (state.launch === 'all' || (state.launch === 'ea') === !!s[6]);
    const compute = () => {
      const want = new Map(data.servers.filter(pick).map((s) => [s[0], s]));
      const needle = state.q.trim().toLowerCase();
      rows = [];
      for (const it of data.items) {
        if (state.section !== 'all' && it[2] !== state.section) continue;
        if (needle && !it[1].toLowerCase().includes(needle)) continue;
        const p = data.prices[it[0]], list: Row['list'] = [];
        for (let i = 0; i < p.length; i += 3) {
          const s = want.get(p[i]);
          if (s && p[i + 2] >= state.minl) list.push({ s, price: p[i + 1], n: p[i + 2] });
        }
        if (list.length < 2) continue;
        list.sort((a, b) => a.price - b.price || a.s[1].localeCompare(b.s[1]));
        const min = list[0].price, max = list[list.length - 1].price;
        const me = state.server ? list.findIndex((e) => e.s[0] === state.server) : -1;
        if (state.server && me < 0) continue;
        const here = me >= 0 ? list[me].price : 0;
        rows.push(me >= 0
          ? { key: it[0], name: it[1], cat: it[3], vol: it[4], list, me, min: here, max: min, spread: (here - min) / min }
          : { key: it[0], name: it[1], cat: it[3], vol: it[4], list, me, min, max, spread: (max - min) / min });
      }
      const k = state.sort as 'name' | 'min' | 'max' | 'spread' | 'vol';
      rows.sort((a, b) => (k === 'name' ? a.name.localeCompare(b.name) : a[k] - b[k]) * state.dir || a.name.localeCompare(b.name));
    };

    const sv = (r: Row['list'][number], faction: boolean) => `${faction ? `<i class="dot" title="${r.s[4]}" style="--h:${r.s[4] === 'Elyos' ? 200 : 290}"></i>` : ''}${esc(r.s[1])}`;
    const render = () => {
      const both = state.faction === 'all';
      status.textContent = `${nf.format(rows.length)} items · updated ${ago(data.generated)}`;
      table.hidden = !rows.length;
      empty.hidden = !!rows.length;
      rowsEl.innerHTML = rows.map((r) => {
        const lo = r.list[0], hi = r.list[r.list.length - 1], isOpen = open.has(r.key);
        const head = `<tr class="mrow" data-k="${r.key}" data-open="${isOpen}"><th scope="row"><button type="button" class="nb" aria-expanded="${isOpen}"><b>${esc(r.name)}</b><small>${esc(r.cat)} · ${r.list.length} servers${r.vol ? ` · ${kin(r.vol)} traded` : ''}</small></button></th>` +
          (r.me >= 0
            ? `<td><b>${nf.format(r.min)}</b><small>${r.me + 1} of ${r.list.length}</small></td><td><b>${nf.format(lo.price)}</b><small>${r.me === 0 ? 'this server' : sv(lo, both)}</small></td>`
            : `<td><b>${nf.format(lo.price)}</b><small>${sv(lo, both)}</small></td><td><b>${nf.format(hi.price)}</b><small>${sv(hi, both)}</small></td>`) +
          (r.me >= 0 ? `<td class="diff${r.me === 0 ? ' best' : ' over'}">${r.me === 0 ? 'Cheapest' : '+' + pct(r.spread)}<small>${r.me === 0 ? '' : nf.format(r.min - lo.price)}</small></td></tr>` : `<td class="diff">${pct(r.spread)}<small>${nf.format(hi.price - lo.price)}</small></td></tr>`);
        if (!isOpen) return head;
        const list = r.list.map((e, i) => `<div class="sr${i === 0 ? " lo" : i === r.list.length - 1 ? " hi" : ""}${i === r.me ? " me" : ""}" style="--w:${Math.max(8, Math.round((e.price / hi.price) * 100))}%;--h:${e.s[4] === "Elyos" ? 200 : 290}"><b class="rk">${i + 1}</b><span class="nm"><i class="dot" title="${e.s[4]}"></i><span>${esc(e.s[1])}</span></span><span class="pr">${nf.format(e.price)}</span><span class="ls">${e.n} listed</span><span class="up">${i === 0 ? "" : `+${Math.round(((e.price - lo.price) / lo.price) * 100)}%`}</span></div>`).join("");
        return head + `<tr class="detail"><td colspan="4"><div class="sv">${list}</div></td></tr>`;
      }).join('');
      const heads = document.querySelectorAll<HTMLElement>('#table thead button');
      [heads[1].textContent, heads[2].textContent, heads[3].textContent] = state.server ? ['This server', 'Cheapest', 'Over cheapest'] : ['Cheapest', 'Most expensive', 'Gap'];
      $('#vol').setAttribute('aria-pressed', String(state.sort === 'vol'));
      document.querySelectorAll<HTMLElement>('#table th[data-s], #table thead th').forEach((th) => {
        const b = th.querySelector<HTMLElement>('button');
        if (!b) return;
        if (b.dataset.sort === state.sort) th.setAttribute('aria-sort', state.dir > 0 ? 'ascending' : 'descending'); else th.removeAttribute('aria-sort');
      });
    };
    const serverEl = $<HTMLSelectElement>('#server');
    const syncServers = () => {
      const pool = data.servers.filter(pick).sort((a, b) => a[1].localeCompare(b[1]) || a[4].localeCompare(b[4]));
      if (!pool.some((s) => s[0] === state.server)) state.server = 0;
      serverEl.innerHTML = '<option value="0">All servers</option>' + pool.map((s) => `<option value="${s[0]}">${esc(s[1])}${state.faction === 'all' ? ' · ' + s[4] : ''}</option>`).join('');
      serverEl.value = String(state.server);
    };
    serverEl.addEventListener('change', () => { state.server = Number(serverEl.value); refresh(); }, { signal });
    const refresh = () => { compute(); render(); $('#scroll').scrollTop = 0; };

    document.querySelectorAll<HTMLElement>('#faction, #launch, #section, #minl').forEach((g) => g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      if (g.id === 'minl') state.minl = Number(b.dataset.v); else state[g.id as 'faction' | 'launch' | 'section'] = b.dataset.v!;
      if (g.id === 'launch') { regionsEl(); checked('region', state.region); }
      checked(g.id, b.dataset.v!); persist(); syncServers(); refresh();
    }, { signal }));
    $('#region').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      state.region = b.dataset.v!; checked('region', state.region); persist(); syncServers(); refresh();
    }, { signal });
    let t = 0;
    q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { state.q = q.value; refresh(); }, 120); }, { signal });
    $('#prices').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-sort]');
      if (!b) return;
      const s = b.dataset.sort!;
      if (s === 'vol') { state.sort = 'vol'; state.dir = -1; } else if (state.sort === s) state.dir = -state.dir; else { state.sort = s; state.dir = s === 'name' || s === 'min' ? 1 : -1; }
      compute(); render();
    }, { signal });
    const toggle = (el: Element | null) => {
      const tr = el?.closest<HTMLElement>('tr.mrow');
      if (!tr) return;
      const k = Number(tr.dataset.k);
      if (!open.delete(k)) open.add(k);
      render();
      rowsEl.querySelector<HTMLElement>(`tr.mrow[data-k="${k}"] .nb`)?.focus();
    };
    rowsEl.addEventListener('click', (e) => toggle(e.target as Element), { signal });

    checked('minl', String(state.minl));
    checked('faction', state.faction); checked('launch', state.launch); checked('section', state.section);
    load().then((d) => {
      if (signal.aborted) return;
      data = d;
      const regions = [...new Map(d.servers.map((s) => [s[2], s[3]])).entries()];
      if (!regions.some(([c]) => c === state.region)) state.region = regions.some(([c]) => c === 'EU') ? 'EU' : regions[0][0];
      regionsEl = () => $('#region').innerHTML = regions.map(([c, n]) => `<button type="button" class="tog" role="radio" aria-checked="false" data-v="${esc(c)}">${esc(n.replace('North America', 'NA'))}<small>${d.servers.filter((s) => s[2] === c && (state.launch === 'all' || (state.launch === 'ea') === !!s[6])).length} servers</small></button>`).join('');
      regionsEl(); checked('region', state.region);
      syncServers(); refresh();
    }).catch(() => { status.textContent = 'Prices could not be loaded'; });
  });
</script>
